<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HTML to PDF Converter - FileVora</title>
    <meta name="description" content="Convert HTML content to PDF quickly and easily with FileVora.">

    <link rel="stylesheet" href="/css/style.css">

    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">
</head>

<body class="pdf-tool">
<%- include("partials/tool-header") %>

<main class="converter-page">
        <div class="container">

            <div class="converter-card">

                <div class="converter-header">

                    <div class="tool-icon">
                        PDF
                    </div>

                    <h1>HTML to PDF Converter</h1>

                    <p>
                        Convert HTML content into a downloadable PDF file.
                    </p>

                </div>

                <textarea
                    id="htmlInput"
                    placeholder="<h1>FileVora</h1>

<p>This is a sample HTML document.</p>

<ul>
    <li>Image Tools</li>
    <li>PDF Tools</li>
    <li>Text Tools</li>
</ul>"
                    style="
                        width:100%;
                        min-height:250px;
                        padding:16px;
                        border:1px solid #cbd5e1;
                        border-radius:12px;
                        resize:vertical;
                        font-family:monospace;
                        font-size:14px;
                        line-height:1.5;
                        box-sizing:border-box;
                        outline:none;
                    "
                ></textarea>

                <button
                    class="convert-btn"
                    id="previewBtn"
                    type="button"
                >
                    Preview HTML
                </button>

                <div
                    id="previewWrapper"
                    style="
                        display:none;
                        margin-top:24px;
                        padding:20px;
                        border:1px solid #e2e8f0;
                        border-radius:12px;
                        background:#ffffff;
                        text-align:left;
                        overflow:auto;
                    "
                >

                    <div
                        id="preview"
                        style="
                            width:100%;
                            min-height:200px;
                            color:#111827;
                            line-height:1.6;
                            background:#ffffff;
                        "
                    ></div>

                </div>

                <button
                    class="convert-btn"
                    id="convertBtn"
                    type="button"
                    disabled
                >
                    Convert to PDF
                </button>

                <div
                    class="result"
                    id="result"
                >

                    <h2>PDF Ready</h2>

                    <p>
                        Your HTML content has been converted to PDF successfully.
                    </p>

                    <a
                        href="#"
                        class="download-btn"
                        id="downloadBtn"
                    >
                        â¬‡ Download PDF
                    </a>

                </div>

            </div>

        </div>
    </main>

    <script>

        const htmlInput =
            document.getElementById("htmlInput");

        const previewBtn =
            document.getElementById("previewBtn");

        const previewWrapper =
            document.getElementById("previewWrapper");

        const preview =
            document.getElementById("preview");

        const convertBtn =
            document.getElementById("convertBtn");

        const result =
            document.getElementById("result");

        const downloadBtn =
            document.getElementById("downloadBtn");


        previewBtn.addEventListener("click", function () {

            const html = htmlInput.value.trim();

            if (!html) {
                alert("Please enter HTML content.");
                return;
            }

            preview.innerHTML = html;

            previewWrapper.style.display = "block";

            convertBtn.disabled = false;

            result.style.display = "none";

        });


        convertBtn.addEventListener("click", async function () {

            if (!htmlInput.value.trim()) {
                alert("Please enter HTML content.");
                return;
            }

            if (!preview.innerHTML.trim()) {
                preview.innerHTML = htmlInput.value;

                previewWrapper.style.display = "block";
            }

            convertBtn.disabled = true;
            convertBtn.textContent = "Creating PDF...";

            try {

                await new Promise(resolve =>
                    setTimeout(resolve, 300)
                );

                const canvas = await html2canvas(
                    preview,
                    {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: "#ffffff"
                    }
                );

                const {
                    jsPDF
                } = window.jspdf;

                const pdf = new jsPDF({
                    orientation: "portrait",
                    unit: "mm",
                    format: "a4"
                });

                const pageWidth = 210;
                const pageHeight = 297;

                const margin = 10;

                const usableWidth =
                    pageWidth - (margin * 2);

                const imageHeight =
                    canvas.height *
                    usableWidth /
                    canvas.width;

                let heightLeft = imageHeight;

                let position = margin;

                const imageData =
                    canvas.toDataURL(
                        "image/jpeg",
                        0.95
                    );

                pdf.addImage(
                    imageData,
                    "JPEG",
                    margin,
                    position,
                    usableWidth,
                    imageHeight
                );

                heightLeft -=
                    pageHeight - (margin * 2);

                while (heightLeft > 0) {

                    position =
                        -(imageHeight - heightLeft) +
                        margin;

                    pdf.addPage();

                    pdf.addImage(
                        imageData,
                        "JPEG",
                        margin,
                        position,
                        usableWidth,
                        imageHeight
                    );

                    heightLeft -=
                        pageHeight - (margin * 2);
                }

                const pdfBlob =
                    pdf.output("blob");

                const url =
                    URL.createObjectURL(pdfBlob);

                downloadBtn.href = url;

                downloadBtn.download =
                    "filevora-html.pdf";

                result.style.display = "block";

            } catch (error) {

                console.error(error);

                alert(
                    "Unable to create PDF. Please check your HTML content and try again."
                );

            } finally {

                convertBtn.disabled = false;

                convertBtn.textContent =
                    "Convert to PDF";

            }

        });

    </script>

