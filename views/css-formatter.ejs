<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CSS Formatter - FileVora</title>
    <meta name="description" content="Format and beautify CSS code online with FileVora.">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

    <style>
        .css-action-row{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
            margin-top:18px;
        }

        .css-action-row .convert-btn{
            width:100% !important;
            height:50px !important;
            min-height:50px !important;
            margin:0 !important;
            box-sizing:border-box !important;
        }

        .css-reset-btn{
            background:#ffffff !important;
            color:#ef1f2b !important;
            border:1px solid #ef1f2b !important;
            box-shadow:none !important;
        }

        .css-reset-btn:hover{
            background:#fff5f5 !important;
        }

        .css-result-actions{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
            margin-top:15px;
        }

        .css-result-actions .download-btn{
            width:100% !important;
            margin:0 !important;
            box-sizing:border-box !important;
            text-align:center !important;
        }

        @media (max-width:600px){
            .css-action-row,
            .css-result-actions{
                grid-template-columns:1fr;
            }
        }
    </style>
</head>

<body>

<%- include("partials/tool-header") %>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    CSS
                </div>

                <h1>CSS Formatter</h1>

                <p>
                    Beautify and format CSS code with clean indentation.
                </p>

            </div>


            <div style="text-align:left;">

                <label
                    for="cssInput"
                    style="
                        display:block;
                        margin-bottom:8px;
                        font-weight:700;
                        color:#111827;
                    "
                >
                    CSS Code
                </label>


                <textarea
                    id="cssInput"
                    placeholder="Paste your CSS code here..."
                    style="
                        width:100%;
                        min-height:320px;
                        padding:16px;
                        border:1px solid #cbd5e1;
                        border-radius:12px;
                        resize:vertical;
                        font-family:monospace;
                        font-size:14px;
                        line-height:1.6;
                        box-sizing:border-box;
                        outline:none;
                    "
                ></textarea>

            </div>


            <div class="css-action-row">

                <button
                    type="button"
                    class="convert-btn"
                    id="formatBtn"
                >
                    Format CSS
                </button>

                <button
                    type="button"
                    class="convert-btn css-reset-btn"
                    id="resetBtn"
                >
                    Reset
                </button>

            </div>


            <div
                id="errorMessage"
                style="
                    display:none;
                    margin-top:18px;
                    padding:14px 18px;
                    background:#fef2f2;
                    border:1px solid #fecaca;
                    border-radius:10px;
                    color:#b91c1c;
                    text-align:left;
                "
            ></div>


            <div
                class="result"
                id="result"
                style="display:none;"
            >

                <h2>
                    CSS Formatted
                </h2>

                <p>
                    Your CSS code has been successfully formatted.
                </p>


                <textarea
                    id="output"
                    readonly
                    style="
                        width:100%;
                        min-height:320px;
                        margin-top:18px;
                        padding:16px;
                        border:1px solid #bbf7d0;
                        border-radius:10px;
                        background:#ffffff;
                        resize:vertical;
                        font-family:monospace;
                        font-size:14px;
                        line-height:1.6;
                        box-sizing:border-box;
                        outline:none;
                    "
                ></textarea>


                <div class="css-result-actions">

                    <button
                        type="button"
                        class="download-btn"
                        id="copyBtn"
                    >
                        Copy CSS
                    </button>

                    <a
                        id="downloadBtn"
                        class="download-btn"
                        href="#"
                        download="formatted.css"
                    >
                        Download CSS
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

const cssInput =
    document.getElementById("cssInput");

const formatBtn =
    document.getElementById("formatBtn");

const resetBtn =
    document.getElementById("resetBtn");

const errorMessage =
    document.getElementById("errorMessage");

const result =
    document.getElementById("result");

const output =
    document.getElementById("output");

const copyBtn =
    document.getElementById("copyBtn");

const downloadBtn =
    document.getElementById("downloadBtn");


let currentDownloadUrl =
    null;


/* =========================
   FORMAT CSS
========================= */

function formatCSS() {

    const input =
        cssInput.value.trim();


    result.style.display =
        "none";


    errorMessage.style.display =
        "none";


    if (!input) {

        showError(
            "Please enter CSS code."
        );

        return;
    }


    try {

        const formatted =
            beautifyCSS(
                input
            );


        output.value =
            formatted;


        const blob =
            new Blob(
                [formatted],
                {
                    type:
                        "text/css;charset=utf-8;"
                }
            );


        if (
            currentDownloadUrl
        ) {

            URL.revokeObjectURL(
                currentDownloadUrl
            );
        }


        currentDownloadUrl =
            URL.createObjectURL(
                blob
            );


        downloadBtn.href =
            currentDownloadUrl;


        result.style.display =
            "block";


        result.scrollIntoView({
            behavior:"smooth",
            block:"nearest"
        });


    } catch (error) {

        showError(
            "Unable to format the CSS code."
        );
    }

}


/* =========================
   BEAUTIFY CSS
========================= */

function beautifyCSS(css) {

    css =
        css
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .trim();


    css =
        css
            .replace(/\{/g, "{\n")
            .replace(/\}/g, "\n}\n")
            .replace(/;/g, ";\n");


    css =
        css
            .replace(/\n\s*\n+/g, "\n")
            .trim();


    const lines =
        css.split("\n");


    let formatted =
        "";

    let indent =
        0;


    lines.forEach(
        function (line) {

            line =
                line.trim();


            if (!line) {
                return;
            }


            if (
                line.startsWith("}")
            ) {

                indent =
                    Math.max(
                        0,
                        indent - 1
                    );


                formatted +=
                    getIndent(indent) +
                    "}\n";


                const remaining =
                    line
                        .substring(1)
                        .trim();


                if (remaining) {

                    formatted +=
                        getIndent(indent) +
                        remaining +
                        "\n";
                }


                return;
            }


            if (
                line.endsWith("{")
            ) {

                formatted +=
                    getIndent(indent) +
                    line +
                    "\n";


                indent++;


                return;
            }


            formatted +=
                getIndent(indent) +
                line +
                "\n";

        }
    );


    return formatted.trim();
}


/* =========================
   INDENT
========================= */

function getIndent(level) {

    return "    ".repeat(
        level
    );
}


/* =========================
   COPY CSS
========================= */

copyBtn.addEventListener(
    "click",
    async function () {

        if (!output.value) {
            return;
        }


        try {

            await navigator.clipboard.writeText(
                output.value
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy CSS";

                },
                1500
            );


        } catch (error) {

            output.select();


            document.execCommand(
                "copy"
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy CSS";

                },
                1500
            );
        }

    }
);


/* =========================
   ERROR
========================= */

function showError(message) {

    errorMessage.textContent =
        message;


    errorMessage.style.display =
        "block";


    result.style.display =
        "none";
}


/* =========================
   RESET
========================= */

resetBtn.addEventListener(
    "click",
    function () {

        cssInput.value =
            "";


        output.value =
            "";


        errorMessage.textContent =
            "";


        errorMessage.style.display =
            "none";


        result.style.display =
            "none";


        copyBtn.textContent =
            "Copy CSS";


        if (
            currentDownloadUrl
        ) {

            URL.revokeObjectURL(
                currentDownloadUrl
            );


            currentDownloadUrl =
                null;
        }


        downloadBtn.href =
            "#";


        cssInput.focus();

    }
);


/* =========================
   EVENT
========================= */

formatBtn.addEventListener(
    "click",
    formatCSS
);

</script>


<footer class="site-footer">

