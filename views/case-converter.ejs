```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Case Converter - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    Aa
                </div>

                <h1>Case Converter</h1>

                <p>
                    Convert your text to uppercase, lowercase, title case and sentence case.
                </p>

            </div>


            <textarea
                id="textInput"
                placeholder="Type or paste your text here..."
                style="
                    width:100%;
                    min-height:260px;
                    padding:18px;
                    border:2px solid #e2e8f0;
                    border-radius:14px;
                    resize:vertical;
                    outline:none;
                    font-family:inherit;
                    font-size:15px;
                    line-height:1.6;
                    color:#111827;
                    background:#ffffff;
                    box-sizing:border-box;
                "
            ></textarea>


            <div
                style="
                    display:grid;
                    grid-template-columns:repeat(2, 1fr);
                    gap:12px;
                    margin-top:20px;
                "
            >

                <button
                    type="button"
                    class="convert-btn"
                    id="upperBtn"
                    style="margin-top:0;"
                >
                    UPPERCASE
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="lowerBtn"
                    style="margin-top:0;"
                >
                    lowercase
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="titleBtn"
                    style="margin-top:0;"
                >
                    Title Case
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="sentenceBtn"
                    style="margin-top:0;"
                >
                    Sentence case
                </button>

            </div>


            <div
                style="
                    display:flex;
                    gap:10px;
                    margin-top:12px;
                "
            >

                <button
                    type="button"
                    class="download-btn"
                    id="copyBtn"
                    style="
                        flex:1;
                        border:none;
                        margin-top:0;
                    "
                >
                    Copy Text
                </button>

                <button
                    type="button"
                    class="download-btn"
                    id="clearBtn"
                    style="
                        flex:1;
                        border:none;
                        margin-top:0;
                    "
                >
                    Clear
                </button>

            </div>

        </div>

    </div>

</main>


<script>

const textInput =
    document.getElementById("textInput");

const upperBtn =
    document.getElementById("upperBtn");

const lowerBtn =
    document.getElementById("lowerBtn");

const titleBtn =
    document.getElementById("titleBtn");

const sentenceBtn =
    document.getElementById("sentenceBtn");

const copyBtn =
    document.getElementById("copyBtn");

const clearBtn =
    document.getElementById("clearBtn");


/* =========================
   UPPERCASE
========================= */

upperBtn.addEventListener("click", function () {

    textInput.value =
        textInput.value.toUpperCase();

    textInput.focus();

});


/* =========================
   LOWERCASE
========================= */

lowerBtn.addEventListener("click", function () {

    textInput.value =
        textInput.value.toLowerCase();

    textInput.focus();

});


/* =========================
   TITLE CASE
========================= */

titleBtn.addEventListener("click", function () {

    textInput.value =
        textInput.value
            .toLowerCase()
            .replace(
                /\b\w/g,
                function (letter) {
                    return letter.toUpperCase();
                }
            );

    textInput.focus();

});


/* =========================
   SENTENCE CASE
========================= */

sentenceBtn.addEventListener("click", function () {

    let text =
        textInput.value
            .toLowerCase();


    text =
        text.replace(
            /(^\s*[a-z])|([.!?]\s*[a-z])/g,
            function (match) {

                return match.toUpperCase();

            }
        );


    textInput.value =
        text;

    textInput.focus();

});


/* =========================
   COPY
========================= */

copyBtn.addEventListener("click", async function () {

    if (!textInput.value) {
        return;
    }


    try {

        await navigator.clipboard.writeText(
            textInput.value
        );

    } catch (error) {

        const textarea =
            document.createElement("textarea");

        textarea.value =
            textInput.value;

        textarea.style.position =
            "fixed";

        textarea.style.opacity =
            "0";

        document.body.appendChild(
            textarea
        );

        textarea.select();

        document.execCommand(
            "copy"
        );

        textarea.remove();

    }


    const oldText =
        copyBtn.textContent;

    copyBtn.textContent =
        "Copied!";


    setTimeout(function () {

        copyBtn.textContent =
            oldText;

    }, 1200);

});


/* =========================
   CLEAR
========================= */

clearBtn.addEventListener("click", function () {

    textInput.value = "";

    textInput.focus();

});

</script>

</body>
</html>
```
