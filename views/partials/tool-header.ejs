<header class="site-header">
  <div class="container nav">

    <a class="brand" href="/" aria-label="FileVora home">
      <span class="brand-mark">F</span>
      <span class="brand-name">File<span>Vora</span></span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="/">Home</a>

      <button
        type="button"
        class="header-nav-btn"
        id="globalToolsBtn"
      >
        Tools
      </button>

      <button
        type="button"
        class="header-nav-btn"
        id="globalCategoriesBtn"
      >
        Categories
      </button>

      <a href="/#why">Why FileVora</a>
    </nav>

    <a class="nav-contact" href="/contact">
      Contact
    </a>

  </div>
</header>


<div
  class="global-tool-panel"
  id="globalToolPanel"
>
  <div class="global-tool-inner">

    <input
      type="text"
      class="global-tool-search"
      id="globalToolSearch"
      placeholder="Search a tool..."
      autocomplete="off"
    >

    <div
      class="global-tool-results"
      id="globalToolResults"
    ></div>

  </div>
</div>


<div
  class="global-category-panel"
  id="globalCategoryPanel"
>

  <div class="global-category-grid">

    <button
      type="button"
      class="global-category-btn"
      data-category="Image Tools"
    >
      Image Tools
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="PDF Tools"
    >
      PDF Tools
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="Text Tools"
    >
      Text Tools
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="Calculators & Utilities"
    >
      Calculators & Utilities
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="Developer Tools"
    >
      Developer Tools
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="Security & Utility"
    >
      Security & Utility
    </button>

    <button
      type="button"
      class="global-category-btn"
      data-category="Audio & Voice"
    >
      Audio & Voice
    </button>

  </div>

  <div
    class="category-tools-box"
    id="categoryToolsBox"
  >

    <h3
      class="category-tools-title"
      id="categoryToolsTitle"
    ></h3>

    <div
      class="category-tools-grid"
      id="categoryToolsGrid"
    ></div>

  </div>

</div>