<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CSV to JSON Converter - FileVora</title>
    <meta name="description" content="Convert CSV data to JSON format quickly and easily with FileVora.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    CSV
                </div>

                <h1>CSV to JSON Converter</h1>

                <p>
                    Convert CSV data into JSON format quickly and easily.
                </p>

            </div>

            <div style="text-align:left;">

                <label for="csvInput"
                       style="display:block; margin-bottom:8px; font-weight:700; color:#111827;">
                    CSV Data
                </label>

                <textarea
                    id="csvInput"
                    placeholder="Example:
name,age,city
John,25,Colombo
Sarah,30,Kandy"
                    style="
                        width:100%;
                        min-height:260px;
                        padding:16px;
                        border:1px solid #cbd5e1;
                        border-radius:12px;
                        resize:vertical;
                        font-family:monospace;
                        font-size:14px;
                        line-height:1.6;
                        box-sizing:border-box;
                        outline:none;
                    "
                ></textarea>

            </div>

            <button
                class="convert-btn"
                onclick="convertCSVToJSON()"
            >
                Convert to JSON
            </button>

            <div id="errorMessage"
                 style="
                    display:none;
                    margin-top:18px;
                    padding:14px 18px;
                    background:#fef2f2;
                    border:1px solid #fecaca;
                    border-radius:10px;
                    color:#b91c1c;
                    text-align:left;
                 ">
            </div>

            <div class="result" id="result">

                <h2>Conversion Complete</h2>

                <p>
                    Your CSV data has been successfully converted to JSON.
                </p>

                <a
                    id="downloadBtn"
                    class="download-btn"
                    href="#"
                    download="filevora-data.json"
                >
                    ↓ Download JSON
                </a>

            </div>

        </div>

    </div>

</div>

<script>

function convertCSVToJSON() {

    const input = document.getElementById("csvInput").value.trim();
    const errorMessage = document.getElementById("errorMessage");
    const result = document.getElementById("result");
    const downloadBtn = document.getElementById("downloadBtn");

    errorMessage.style.display = "none";
    result.style.display = "none";

    if (!input) {
        showError("Please enter CSV data.");
        return;
    }

    try {

        const rows = parseCSV(input);

        if (rows.length < 2) {
            showError("CSV must contain a header row and at least one data row.");
            return;
        }

        const headers = rows[0];

        if (headers.length === 0) {
            showError("No CSV headers were found.");
            return;
        }

        const jsonData = [];

        for (let i = 1; i < rows.length; i++) {

            const row = rows[i];

            // Skip completely empty rows
            if (row.every(value => value.trim() === "")) {
                continue;
            }

            const object = {};

            headers.forEach((header, index) => {

                object[header.trim()] =
                    row[index] !== undefined ? row[index].trim() : "";

            });

            jsonData.push(object);
        }

        if (jsonData.length === 0) {
            showError("No data rows were found.");
            return;
        }

        const jsonContent = JSON.stringify(jsonData, null, 2);

        const blob = new Blob(
            [jsonContent],
            {
                type: "application/json;charset=utf-8;"
            }
        );

        const url = URL.createObjectURL(blob);

        downloadBtn.href = url;

        result.style.display = "block";

    } catch (error) {

        showError("Invalid CSV format. Please check your data.");

    }
}


function parseCSV(text) {

    const rows = [];
    let row = [];
    let value = "";
    let insideQuotes = false;

    for (let i = 0; i < text.length; i++) {

        const char = text[i];
        const nextChar = text[i + 1];

        if (char === '"' && insideQuotes && nextChar === '"') {

            value += '"';
            i++;

        } else if (char === '"') {

            insideQuotes = !insideQuotes;

        } else if (char === "," && !insideQuotes) {

            row.push(value);
            value = "";

        } else if (
            (char === "\n" || char === "\r") &&
            !insideQuotes
        ) {

            if (char === "\r" && nextChar === "\n") {
                i++;
            }

            row.push(value);
            rows.push(row);

            row = [];
            value = "";

        } else {

            value += char;

        }
    }

    row.push(value);

    if (row.length > 1 || row[0] !== "") {
        rows.push(row);
    }

    return rows;
}


function showError(message) {

    const errorMessage = document.getElementById("errorMessage");

    errorMessage.textContent = message;
    errorMessage.style.display = "block";
}

</script>

</body>
</html>