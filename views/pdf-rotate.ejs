<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rotate PDF - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

    <style>
        #rotateControls {
            display: none;
            margin-top: 20px;
        }

        .rotate-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .rotate-option {
            padding: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #ffffff;
            cursor: pointer;
            font-weight: 600;
            color: #334155;
            transition: 0.2s;
        }

        .rotate-option:hover {
            border-color: #00bc8a;
            background: #ecfdf8;
        }

        .rotate-option.active {
            border-color: #00bc8a;
            background: #ecfdf8;
            color: #00bc8a;
        }

        #rotateActions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            width: 100%;
            margin-top: 16px;
        }

        #rotateActions #rotateBtn,
        #rotateActions #resetBtn {
            width: 100% !important;
            height: 50px !important;
            min-height: 50px !important;
            margin: 0 !important;
            padding: 0 20px !important;
            box-sizing: border-box !important;
        }

        #rotateActions #resetBtn {
            background: #ffffff !important;
            color: #00bc8a !important;
            border: 1px solid #00bc8a !important;
            box-shadow: none !important;
        }

        #rotateActions #resetBtn:hover {
            background: #ecfdf8 !important;
            color: #00bc8a !important;
        }

        .status-message {
            margin-top: 16px;
            color: #64748b;
            font-size: 14px;
        }

        .error-message {
            display: none;
            margin-top: 18px;
            padding: 14px;
            border-radius: 10px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .rotate-options,
            #rotateActions {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body class="pdf-tool">

<%- include("partials/tool-header") %>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    PDF
                </div>

                <h1>Rotate PDF</h1>

                <p>
                    Rotate all pages of your PDF and download the rotated document.
                </p>

            </div>


            <label class="upload-area" for="pdfInput">

                <div class="upload-icon">
                    ↑
                </div>

                <strong>
                    Choose a PDF file
                </strong>

                <span>
                    Click here to select your PDF
                </span>

            </label>


            <input
                type="file"
                id="pdfInput"
                accept="application/pdf,.pdf"
            >


            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <div id="rotateControls">

                <div class="rotate-options">

                    <button
                        type="button"
                        class="rotate-option active"
                        data-angle="90"
                    >
                        Rotate 90°
                    </button>

                    <button
                        type="button"
                        class="rotate-option"
                        data-angle="180"
                    >
                        Rotate 180°
                    </button>

                    <button
                        type="button"
                        class="rotate-option"
                        data-angle="270"
                    >
                        Rotate 270°
                    </button>

                    <button
                        type="button"
                        class="rotate-option"
                        data-angle="0"
                    >
                        No Rotation
                    </button>

                </div>


                <div id="rotateActions">

                    <button
                        class="convert-btn"
                        id="rotateBtn"
                        type="button"
                        disabled
                    >
                        Rotate PDF
                    </button>

                    <button
                        class="convert-btn reset-btn"
                        id="resetBtn"
                        type="button"
                    >
                        Reset
                    </button>

                </div>

            </div>


            <div
                class="status-message"
                id="statusMessage"
            ></div>


            <div
                class="error-message"
                id="errorMessage"
            ></div>


            <div
                class="result"
                id="result"
            >

                <h2>
                    PDF Rotated Successfully
                </h2>

                <p>
                    Your rotated PDF is ready to download.
                </p>

                <a
                    href="#"
                    id="downloadBtn"
                    class="download-btn"
                    download="filevora-rotated.pdf"
                >
                    Download Rotated PDF
                </a>

            </div>

        </div>

    </div>

</main>


<footer class="site-footer">

    <div class="container footer-grid">

        <div class="footer-brand">

            <a class="brand" href="/">
                <span class="brand-mark">F</span>
                <span class="brand-name">
                    File<span>Vora</span>
                </span>
            </a>

            <p>
                Fast, simple online tools for everyday file tasks.
            </p>

        </div>

        <div>
            <h3>Company</h3>
            <a href="/about">About Us</a>
            <a href="/contact">Contact Us</a>
            <a href="/security">Security</a>
        </div>

        <div>
            <h3>Resources</h3>
            <a href="/blog">Blog</a>
            <a href="/#tools">Tools</a>
            <a href="/faq">FAQ</a>
        </div>

        <div>
            <h3>Legal</h3>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/disclaimer">Disclaimer</a>
        </div>

        <div>
            <h3>Contact</h3>
            <a href="/contact">Email</a>
            <a href="/contact">Facebook</a>
            <a href="/contact">Instagram</a>
        </div>

    </div>

    <div class="container footer-bottom">

        <span>
            © <span data-current-year></span> FileVora. All rights reserved.
        </span>

        <span>
            All in One Tool.
        </span>

    </div>

</footer>


<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>


<script>
document
    .querySelectorAll("[data-current-year]")
    .forEach(function (element) {
        element.textContent =
            new Date().getFullYear();
    });
</script>


<script>

const pdfInput =
    document.getElementById("pdfInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const rotateControls =
    document.getElementById("rotateControls");

const rotateBtn =
    document.getElementById("rotateBtn");

const resetBtn =
    document.getElementById("resetBtn");

const downloadBtn =
    document.getElementById("downloadBtn");

const result =
    document.getElementById("result");

const errorMessage =
    document.getElementById("errorMessage");

const statusMessage =
    document.getElementById("statusMessage");

const rotateOptions =
    document.querySelectorAll(".rotate-option");


let selectedAngle = 90;
let selectedFile = null;
let downloadUrl = null;


rotateOptions.forEach(function (option) {

    option.addEventListener(
        "click",
        function () {

            rotateOptions.forEach(
                function (item) {

                    item.classList.remove(
                        "active"
                    );
                }
            );


            option.classList.add(
                "active"
            );


            selectedAngle =
                Number(
                    option.dataset.angle
                );
        }
    );

});


pdfInput.addEventListener(
    "change",
    function () {

        selectedFile =
            pdfInput.files[0];


        result.style.display =
            "none";


        errorMessage.style.display =
            "none";


        statusMessage.textContent =
            "";


        if (!selectedFile) {

            rotateBtn.disabled =
                true;


            fileInfo.style.display =
                "none";


            rotateControls.style.display =
                "none";


            return;
        }


        if (
            selectedFile.type !==
            "application/pdf"
        ) {

            errorMessage.textContent =
                "Please select a valid PDF file.";


            errorMessage.style.display =
                "block";


            pdfInput.value =
                "";


            selectedFile =
                null;


            rotateBtn.disabled =
                true;


            fileInfo.style.display =
                "none";


            rotateControls.style.display =
                "none";


            return;
        }


        fileName.textContent =
            selectedFile.name;


        fileSize.textContent =
            formatFileSize(
                selectedFile.size
            );


        fileInfo.style.display =
            "block";


        rotateBtn.disabled =
            false;


        rotateControls.style.display =
            "block";
    }
);


rotateBtn.addEventListener(
    "click",
    async function () {

        if (!selectedFile) {
            return;
        }


        try {

            rotateBtn.disabled =
                true;


            result.style.display =
                "none";


            errorMessage.style.display =
                "none";


            statusMessage.textContent =
                "Rotating PDF... Please wait.";


            const arrayBuffer =
                await selectedFile.arrayBuffer();


            const pdfDoc =
                await PDFLib.PDFDocument.load(
                    arrayBuffer
                );


            const pages =
                pdfDoc.getPages();


            pages.forEach(
                function (page) {

                    if (
                        selectedAngle !== 0
                    ) {

                        const currentRotation =
                            page.getRotation().angle;


                        const newRotation =
                            (
                                currentRotation +
                                selectedAngle
                            ) % 360;


                        page.setRotation(
                            PDFLib.degrees(
                                newRotation
                            )
                        );
                    }
                }
            );


            const pdfBytes =
                await pdfDoc.save();


            const blob =
                new Blob(
                    [pdfBytes],
                    {
                        type:
                            "application/pdf"
                    }
                );


            if (downloadUrl) {

                URL.revokeObjectURL(
                    downloadUrl
                );
            }


            downloadUrl =
                URL.createObjectURL(
                    blob
                );


            downloadBtn.href =
                downloadUrl;


            result.style.display =
                "block";


            statusMessage.textContent =
                "";


        } catch (error) {

            console.error(error);


            errorMessage.textContent =
                "PDF rotation could not be completed. Please make sure the PDF is valid and not password protected.";


            errorMessage.style.display =
                "block";


            statusMessage.textContent =
                "";


        } finally {

            rotateBtn.disabled =
                false;
        }
    }
);


resetBtn.addEventListener(
    "click",
    function () {

        pdfInput.value =
            "";


        selectedFile =
            null;


        selectedAngle =
            90;


        fileName.textContent =
            "";


        fileSize.textContent =
            "";


        fileInfo.style.display =
            "none";


        rotateControls.style.display =
            "none";


        result.style.display =
            "none";


        errorMessage.style.display =
            "none";


        statusMessage.textContent =
            "";


        rotateBtn.disabled =
            true;


        downloadBtn.href =
            "#";


        rotateOptions.forEach(
            function (item) {

                item.classList.remove(
                    "active"
                );
            }
        );


        const defaultOption =
            document.querySelector(
                '.rotate-option[data-angle="90"]'
            );


        if (defaultOption) {

            defaultOption.classList.add(
                "active"
            );
        }


        if (downloadUrl) {

            URL.revokeObjectURL(
                downloadUrl
            );


            downloadUrl =
                null;
        }
    }
);


function formatFileSize(bytes) {

    if (bytes < 1024) {
        return bytes + " Bytes";
    }


    if (
        bytes <
        1024 * 1024
    ) {

        return (
            bytes / 1024
        ).toFixed(1) + " KB";
    }


    return (
        bytes /
        (1024 * 1024)
    ).toFixed(2) + " MB";
}

</script>


<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>