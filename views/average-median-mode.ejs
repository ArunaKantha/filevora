<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Average Median Mode Calculator - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .statistics-calculator {
            max-width: 760px;
        }

        .numbers-input {
            width: 100%;
            min-height: 150px;
            padding: 16px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            background: #f8fafc;
            color: #111827;
            font-family: inherit;
            font-size: 16px;
            line-height: 1.6;
            resize: vertical;
            outline: none;
            box-sizing: border-box;
        }

        .numbers-input:focus {
            border-color: #2563eb;
            background: #ffffff;
        }

        .input-label {
            display: block;
            margin-bottom: 9px;
            color: #374151;
            font-size: 14px;
            font-weight: 700;
            text-align: left;
        }

        .input-help {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 13px;
            text-align: left;
        }

        .calculate-btn {
            width: 100%;
            margin-top: 22px;
            padding: 14px 22px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .calculate-btn:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .statistics-result {
            display: none;
            margin-top: 28px;
            padding: 24px;
            border-radius: 14px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .statistics-result h2 {
            margin: 0 0 18px;
            color: #166534;
            font-size: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .stat-item {
            padding: 16px;
            background: #ffffff;
            border: 1px solid #dcfce7;
            border-radius: 10px;
            text-align: left;
        }

        .stat-item span {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-size: 13px;
        }

        .stat-item strong {
            display: block;
            color: #166534;
            font-size: 19px;
            word-break: break-word;
        }

        .error-message {
            display: none;
            margin-top: 18px;
            padding: 13px;
            border-radius: 10px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 14px;
            text-align: left;
        }

        @media (max-width: 600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="converter-page">

    <div class="container">

        <div class="converter-card statistics-calculator">

            <div class="converter-header">

                <div class="tool-icon">Σ</div>

                <h1>Average / Median / Mode</h1>

                <p>
                    Calculate mean, median, mode and other statistics from a list of numbers.
                </p>

            </div>


            <label
                class="input-label"
                for="numbersInput">

                Enter Numbers

            </label>


            <textarea
                id="numbersInput"
                class="numbers-input"
                placeholder="Example: 10, 20, 20, 30, 40">
            </textarea>


            <p class="input-help">
                Separate numbers using commas, spaces, or new lines.
            </p>


            <button
                class="calculate-btn"
                onclick="calculateStatistics()">

                Calculate Statistics

            </button>


            <div
                id="errorMessage"
                class="error-message">
            </div>


            <div
                id="statisticsResult"
                class="statistics-result">

                <h2>Results</h2>

                <div class="stats-grid">

                    <div class="stat-item">
                        <span>Average (Mean)</span>
                        <strong id="meanResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Median</span>
                        <strong id="medianResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Mode</span>
                        <strong id="modeResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Sum</span>
                        <strong id="sumResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Count</span>
                        <strong id="countResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Minimum</span>
                        <strong id="minResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Maximum</span>
                        <strong id="maxResult">-</strong>
                    </div>

                    <div class="stat-item">
                        <span>Range</span>
                        <strong id="rangeResult">-</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    function parseNumbers() {

        const input =
            document
                .getElementById("numbersInput")
                .value
                .trim();

        if (!input) {

            throw new Error(
                "Please enter some numbers."
            );
        }


        const values =
            input
                .split(/[\s,]+/)
                .filter(value => value !== "")
                .map(value => Number(value));


        if (values.length === 0) {

            throw new Error(
                "No valid numbers found."
            );
        }


        if (
            values.some(
                value => !Number.isFinite(value)
            )
        ) {

            throw new Error(
                "Please enter valid numbers only."
            );
        }


        return values;
    }


    function formatNumber(number) {

        if (
            Math.abs(number) < 1e-12
        ) {
            number = 0;
        }


        return Number(
            number.toFixed(10)
        ).toString();
    }


    function calculateMean(numbers) {

        const sum =
            numbers.reduce(
                (total, number) =>
                    total + number,
                0
            );

        return sum / numbers.length;
    }


    function calculateMedian(numbers) {

        const sorted =
            [...numbers].sort(
                (a, b) => a - b
            );


        const middle =
            Math.floor(
                sorted.length / 2
            );


        if (sorted.length % 2 === 0) {

            return (
                sorted[middle - 1] +
                sorted[middle]
            ) / 2;
        }


        return sorted[middle];
    }


    function calculateMode(numbers) {

        const frequency = new Map();

        numbers.forEach(number => {

            frequency.set(
                number,
                (frequency.get(number) || 0) + 1
            );

        });


        let highestFrequency = 0;


        frequency.forEach(count => {

            if (
                count > highestFrequency
            ) {

                highestFrequency = count;
            }

        });


        // No repeated number
        if (highestFrequency === 1) {

            return "No mode";
        }


        const modes = [];


        frequency.forEach(
            (count, number) => {

                if (
                    count === highestFrequency
                ) {

                    modes.push(number);
                }

            }
        );


        modes.sort(
            (a, b) => a - b
        );


        return modes
            .map(formatNumber)
            .join(", ");
    }


    function calculateStatistics() {

        const resultBox =
            document.getElementById(
                "statisticsResult"
            );

        const errorBox =
            document.getElementById(
                "errorMessage"
            );


        resultBox.style.display = "none";
        errorBox.style.display = "none";


        try {

            const numbers =
                parseNumbers();


            const sum =
                numbers.reduce(
                    (total, number) =>
                        total + number,
                    0
                );


            const mean =
                calculateMean(numbers);


            const median =
                calculateMedian(numbers);


            const mode =
                calculateMode(numbers);


            const minimum =
                Math.min(...numbers);


            const maximum =
                Math.max(...numbers);


            const range =
                maximum - minimum;


            document.getElementById(
                "meanResult"
            ).textContent =
                formatNumber(mean);


            document.getElementById(
                "medianResult"
            ).textContent =
                formatNumber(median);


            document.getElementById(
                "modeResult"
            ).textContent =
                mode;


            document.getElementById(
                "sumResult"
            ).textContent =
                formatNumber(sum);


            document.getElementById(
                "countResult"
            ).textContent =
                numbers.length;


            document.getElementById(
                "minResult"
            ).textContent =
                formatNumber(minimum);


            document.getElementById(
                "maxResult"
            ).textContent =
                formatNumber(maximum);


            document.getElementById(
                "rangeResult"
            ).textContent =
                formatNumber(range);


            resultBox.style.display =
                "block";

        }

        catch (error) {

            errorBox.textContent =
                error.message;

            errorBox.style.display =
                "block";
        }
    }


    document
        .getElementById("numbersInput")
        .addEventListener(
            "keydown",
            function(event) {

                if (
                    event.ctrlKey &&
                    event.key === "Enter"
                ) {

                    calculateStatistics();
                }

            }
        );

</script>

</body>
</html>