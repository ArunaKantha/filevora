<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Image Flip - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    ⇄
                </div>

                <h1>Image Flip</h1>

                <p>
                    Flip your images horizontally or vertically with ease.
                </p>

            </div>

            <label class="upload-area" for="imageInput">

                <div class="upload-icon">
                    🖼️
                </div>

                <strong>Click to upload an image</strong>

                <span>
                    JPG, PNG, WEBP and other common image formats
                </span>

                <input
                    type="file"
                    id="imageInput"
                    accept="image/*"
                >

            </label>

            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>

            <div
                id="previewArea"
                style="display:none; margin-top:25px;"
            >

                <canvas
                    id="previewCanvas"
                    style="
                        max-width:100%;
                        height:auto;
                        border-radius:12px;
                    "
                ></canvas>

            </div>

            <div
                id="flipControls"
                style="display:none; margin-top:22px;"
            >

                <div
                    style="
                        display:flex;
                        justify-content:center;
                        gap:10px;
                        flex-wrap:wrap;
                    "
                >

                    <button
                        type="button"
                        class="convert-btn"
                        id="flipHorizontal"
                        style="width:auto; margin-top:0;"
                    >
                        ↔️ Flip Horizontal
                    </button>

                    <button
                        type="button"
                        class="convert-btn"
                        id="flipVertical"
                        style="width:auto; margin-top:0;"
                    >
                        ↕️ Flip Vertical
                    </button>

                </div>

            </div>

            <div
                id="formatArea"
                style="display:none; margin-top:20px;"
            >

                <label for="formatSelect">
                    Output Format
                </label>

                <select
                    id="formatSelect"
                    style="
                        margin-left:8px;
                        padding:9px 12px;
                        border:1px solid #cbd5e1;
                        border-radius:8px;
                        background:#fff;
                    "
                >

                    <option value="image/jpeg">
                        JPG
                    </option>

                    <option value="image/png">
                        PNG
                    </option>

                    <option value="image/webp">
                        WEBP
                    </option>

                </select>

            </div>

            <button
                type="button"
                class="convert-btn"
                id="downloadBtn"
                disabled
            >
                ⬇️ Download Flipped Image
            </button>

            <div
                class="result"
                id="result"
            >

                <h2>Image Ready</h2>

                <p>
                    Your flipped image is ready to download.
                </p>

                <a
                    class="download-btn"
                    id="downloadLink"
                    href="#"
                    download
                >
                    ⬇️ Download Image
                </a>

            </div>

        </div>

    </div>

</div>

<script>
const imageInput = document.getElementById("imageInput");

const fileInfo = document.getElementById("fileInfo");
const fileName = document.getElementById("fileName");
const fileSize = document.getElementById("fileSize");

const previewArea = document.getElementById("previewArea");
const previewCanvas = document.getElementById("previewCanvas");

const flipControls = document.getElementById("flipControls");
const formatArea = document.getElementById("formatArea");

const formatSelect = document.getElementById("formatSelect");

const downloadBtn = document.getElementById("downloadBtn");

const result = document.getElementById("result");
const downloadLink = document.getElementById("downloadLink");

const flipHorizontal = document.getElementById("flipHorizontal");
const flipVertical = document.getElementById("flipVertical");

const ctx = previewCanvas.getContext("2d");

let image = null;

let flipX = false;
let flipY = false;

imageInput.addEventListener("change", function () {

    const file = this.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function (event) {

        const img = new Image();

        img.onload = function () {

            image = img;

            flipX = false;
            flipY = false;

            fileName.textContent = file.name;
            fileSize.textContent = formatFileSize(file.size);

            fileInfo.style.display = "block";
            previewArea.style.display = "block";
            flipControls.style.display = "block";
            formatArea.style.display = "block";

            result.style.display = "none";

            downloadBtn.disabled = false;

            drawPreview();
        };

        img.src = event.target.result;
    };

    reader.readAsDataURL(file);
});


function formatFileSize(bytes) {

    if (bytes < 1024) {
        return bytes + " B";
    }

    if (bytes < 1024 * 1024) {
        return (bytes / 1024).toFixed(1) + " KB";
    }

    return (bytes / (1024 * 1024)).toFixed(2) + " MB";
}


function drawPreview() {

    if (!image) return;

    previewCanvas.width = image.naturalWidth;
    previewCanvas.height = image.naturalHeight;

    ctx.clearRect(
        0,
        0,
        previewCanvas.width,
        previewCanvas.height
    );

    ctx.save();

    ctx.translate(
        previewCanvas.width / 2,
        previewCanvas.height / 2
    );

    ctx.scale(
        flipX ? -1 : 1,
        flipY ? -1 : 1
    );

    ctx.drawImage(
        image,
        -image.naturalWidth / 2,
        -image.naturalHeight / 2
    );

    ctx.restore();
}


flipHorizontal.addEventListener("click", function () {

    flipX = !flipX;

    drawPreview();
});


flipVertical.addEventListener("click", function () {

    flipY = !flipY;

    drawPreview();
});


downloadBtn.addEventListener("click", function () {

    if (!image) return;

    const format = formatSelect.value;

    const quality =
        format === "image/png"
            ? 1
            : 0.92;

    previewCanvas.toBlob(function (blob) {

        if (!blob) {

            alert("Could not create the image.");

            return;
        }

        const url = URL.createObjectURL(blob);

        let extension = "jpg";

        if (format === "image/png") {
            extension = "png";
        }

        if (format === "image/webp") {
            extension = "webp";
        }

        downloadLink.href = url;

        downloadLink.download =
            "filevora-flipped-image." + extension;

        result.style.display = "block";

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    }, format, quality);
});
</script>

</body>
</html>