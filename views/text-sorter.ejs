<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Text Sorter - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    ↕
                </div>

                <h1>Text Sorter</h1>

                <p>
                    Sort lines of text alphabetically, numerically or by length.
                </p>

            </div>


            <textarea
                id="textInput"
                placeholder="Enter one item per line..."
                style="
                    width:100%;
                    min-height:280px;
                    padding:18px;
                    border:2px solid #e2e8f0;
                    border-radius:14px;
                    resize:vertical;
                    outline:none;
                    font-family:inherit;
                    font-size:15px;
                    line-height:1.6;
                    color:#111827;
                    background:#ffffff;
                    box-sizing:border-box;
                "
            ></textarea>


            <div
                style="
                    display:grid;
                    grid-template-columns:repeat(2, 1fr);
                    gap:12px;
                    margin-top:20px;
                "
            >

                <button
                    type="button"
                    class="convert-btn"
                    id="azBtn"
                    style="margin-top:0;"
                >
                    A → Z
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="zaBtn"
                    style="margin-top:0;"
                >
                    Z → A
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="numAscBtn"
                    style="margin-top:0;"
                >
                    Numbers ↑
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="numDescBtn"
                    style="margin-top:0;"
                >
                    Numbers ↓
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="shortBtn"
                    style="margin-top:0;"
                >
                    Shortest First
                </button>

                <button
                    type="button"
                    class="convert-btn"
                    id="longBtn"
                    style="margin-top:0;"
                >
                    Longest First
                </button>

            </div>


            <div
                style="
                    display:flex;
                    gap:10px;
                    margin-top:12px;
                "
            >

                <button
                    type="button"
                    class="download-btn"
                    id="copyBtn"
                    style="
                        flex:1;
                        border:none;
                        margin-top:0;
                    "
                >
                    Copy Result
                </button>

                <button
                    type="button"
                    class="download-btn"
                    id="clearBtn"
                    style="
                        flex:1;
                        border:none;
                        margin-top:0;
                    "
                >
                    Clear
                </button>

            </div>


            <div
                id="result"
                style="
                    display:none;
                    margin-top:20px;
                    padding:16px;
                    border-radius:12px;
                    background:#f0fdf4;
                    border:1px solid #bbf7d0;
                    color:#166534;
                    font-size:14px;
                    text-align:left;
                "
            ></div>

        </div>

    </div>

</main>


<script>

const textInput =
    document.getElementById("textInput");

const azBtn =
    document.getElementById("azBtn");

const zaBtn =
    document.getElementById("zaBtn");

const numAscBtn =
    document.getElementById("numAscBtn");

const numDescBtn =
    document.getElementById("numDescBtn");

const shortBtn =
    document.getElementById("shortBtn");

const longBtn =
    document.getElementById("longBtn");

const copyBtn =
    document.getElementById("copyBtn");

const clearBtn =
    document.getElementById("clearBtn");

const result =
    document.getElementById("result");


function getLines() {

    return textInput.value
        .split(/\r?\n/)
        .filter(line => line.trim() !== "");

}


function showResult(message) {

    result.textContent =
        message;

    result.style.display =
        "block";

}


/* =========================
   A → Z
========================= */

azBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return a.localeCompare(
            b,
            undefined,
            {
                numeric: true,
                sensitivity: "base"
            }
        );

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted from A to Z."
    );

});


/* =========================
   Z → A
========================= */

zaBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return b.localeCompare(
            a,
            undefined,
            {
                numeric: true,
                sensitivity: "base"
            }
        );

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted from Z to A."
    );

});


/* =========================
   NUMBERS ASCENDING
========================= */

numAscBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return extractNumber(a) -
               extractNumber(b);

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted by number."
    );

});


/* =========================
   NUMBERS DESCENDING
========================= */

numDescBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return extractNumber(b) -
               extractNumber(a);

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted by number descending."
    );

});


function extractNumber(text) {

    const match =
        text.match(/-?\d+(?:\.\d+)?/);

    return match
        ? Number(match[0])
        : Infinity;

}


/* =========================
   SHORTEST FIRST
========================= */

shortBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return a.length - b.length;

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted shortest first."
    );

});


/* =========================
   LONGEST FIRST
========================= */

longBtn.addEventListener("click", function () {

    const lines =
        getLines();

    if (!lines.length) {

        alert("Please enter some text first.");

        return;
    }


    lines.sort(function (a, b) {

        return b.length - a.length;

    });


    textInput.value =
        lines.join("\n");


    showResult(
        lines.length +
        " lines sorted longest first."
    );

});


/* =========================
   COPY
========================= */

copyBtn.addEventListener("click", async function () {

    const text =
        textInput.value;

    if (!text) {
        return;
    }


    try {

        await navigator.clipboard.writeText(
            text
        );

    } catch (error) {

        const temp =
            document.createElement("textarea");

        temp.value =
            text;

        temp.style.position =
            "fixed";

        temp.style.opacity =
            "0";

        document.body.appendChild(temp);

        temp.select();

        document.execCommand("copy");

        temp.remove();

    }


    const oldText =
        copyBtn.textContent;

    copyBtn.textContent =
        "Copied!";


    setTimeout(function () {

        copyBtn.textContent =
            oldText;

    }, 1200);

});


/* =========================
   CLEAR
========================= */

clearBtn.addEventListener("click", function () {

    textInput.value = "";

    result.style.display =
        "none";

    textInput.focus();

});

</script>

</body>
</html>
