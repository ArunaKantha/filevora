<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Unit Converter - FileVora</title>
    <meta name="description" content="Convert length, weight and temperature units quickly with FileVora Unit Converter.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="converter-page">
        <div class="container">

            <div class="converter-card">

                <div class="converter-header">
                    <div class="tool-icon">↔</div>

                    <h1>Unit Converter</h1>

                    <p>
                        Convert length, weight and temperature units instantly.
                    </p>
                </div>

                <div style="display:grid; gap:16px; text-align:left;">

                    <!-- Category -->
                    <div>
                        <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                            Category
                        </label>

                        <select
                            id="category"
                            style="width:100%; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px; background:#fff;"
                        >
                            <option value="length">Length</option>
                            <option value="weight">Weight</option>
                            <option value="temperature">Temperature</option>
                        </select>
                    </div>

                    <!-- From -->
                    <div>
                        <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                            From
                        </label>

                        <select
                            id="fromUnit"
                            style="width:100%; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px; background:#fff;"
                        ></select>
                    </div>

                    <!-- Value -->
                    <div>
                        <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                            Value
                        </label>

                        <input
                            type="number"
                            id="value"
                            placeholder="Enter value"
                            step="any"
                            style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                        >
                    </div>

                    <!-- To -->
                    <div>
                        <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                            To
                        </label>

                        <select
                            id="toUnit"
                            style="width:100%; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px; background:#fff;"
                        ></select>
                    </div>

                </div>

                <button
                    type="button"
                    class="convert-btn"
                    id="convertBtn"
                >
                    Convert
                </button>

                <div class="result" id="result">

                    <h2>Conversion Result</h2>

                    <p id="resultText"></p>

                </div>

            </div>

        </div>
    </main>

    <script>
        const category = document.getElementById("category");
        const fromUnit = document.getElementById("fromUnit");
        const toUnit = document.getElementById("toUnit");
        const valueInput = document.getElementById("value");
        const convertBtn = document.getElementById("convertBtn");
        const result = document.getElementById("result");
        const resultText = document.getElementById("resultText");

        const units = {

            length: {
                meter: {
                    name: "Meter",
                    factor: 1
                },
                kilometer: {
                    name: "Kilometer",
                    factor: 1000
                },
                centimeter: {
                    name: "Centimeter",
                    factor: 0.01
                },
                millimeter: {
                    name: "Millimeter",
                    factor: 0.001
                },
                mile: {
                    name: "Mile",
                    factor: 1609.344
                },
                yard: {
                    name: "Yard",
                    factor: 0.9144
                },
                foot: {
                    name: "Foot",
                    factor: 0.3048
                },
                inch: {
                    name: "Inch",
                    factor: 0.0254
                }
            },

            weight: {
                kilogram: {
                    name: "Kilogram",
                    factor: 1
                },
                gram: {
                    name: "Gram",
                    factor: 0.001
                },
                milligram: {
                    name: "Milligram",
                    factor: 0.000001
                },
                pound: {
                    name: "Pound",
                    factor: 0.45359237
                },
                ounce: {
                    name: "Ounce",
                    factor: 0.028349523125
                },
                stone: {
                    name: "Stone",
                    factor: 6.35029318
                }
            },

            temperature: {
                celsius: {
                    name: "Celsius"
                },
                fahrenheit: {
                    name: "Fahrenheit"
                },
                kelvin: {
                    name: "Kelvin"
                }
            }

        };

        function loadUnits() {

            const selectedCategory = category.value;
            const categoryUnits = units[selectedCategory];

            fromUnit.innerHTML = "";
            toUnit.innerHTML = "";

            Object.keys(categoryUnits).forEach(key => {

                const option1 = document.createElement("option");
                option1.value = key;
                option1.textContent = categoryUnits[key].name;

                const option2 = document.createElement("option");
                option2.value = key;
                option2.textContent = categoryUnits[key].name;

                fromUnit.appendChild(option1);
                toUnit.appendChild(option2);

            });

            if (Object.keys(categoryUnits).length > 1) {
                toUnit.selectedIndex = 1;
            }

            result.style.display = "none";
        }

        function convertTemperature(value, from, to) {

            let celsius;

            if (from === "celsius") {
                celsius = value;
            } else if (from === "fahrenheit") {
                celsius = (value - 32) * 5 / 9;
            } else if (from === "kelvin") {
                celsius = value - 273.15;
            }

            if (to === "celsius") {
                return celsius;
            }

            if (to === "fahrenheit") {
                return (celsius * 9 / 5) + 32;
            }

            if (to === "kelvin") {
                return celsius + 273.15;
            }
        }

        function formatNumber(number) {

            if (!Number.isFinite(number)) {
                return "Invalid result";
            }

            return Number(number.toFixed(10)).toLocaleString("en-US", {
                maximumFractionDigits: 10
            });
        }

        category.addEventListener("change", loadUnits);

        convertBtn.addEventListener("click", () => {

            const value = parseFloat(valueInput.value);

            if (isNaN(value)) {
                alert("Please enter a valid number.");
                return;
            }

            const selectedCategory = category.value;
            const from = fromUnit.value;
            const to = toUnit.value;

            let convertedValue;

            if (selectedCategory === "temperature") {

                convertedValue = convertTemperature(
                    value,
                    from,
                    to
                );

            } else {

                const fromFactor = units[selectedCategory][from].factor;
                const toFactor = units[selectedCategory][to].factor;

                const baseValue = value * fromFactor;

                convertedValue = baseValue / toFactor;
            }

            const fromName = units[selectedCategory][from].name;
            const toName = units[selectedCategory][to].name;

            resultText.textContent =
                `${formatNumber(value)} ${fromName} = ${formatNumber(convertedValue)} ${toName}`;

            result.style.display = "block";
        });

        valueInput.addEventListener("keydown", (event) => {

            if (event.key === "Enter") {
                convertBtn.click();
            }

        });

        loadUnits();
    </script>

</body>
</html>