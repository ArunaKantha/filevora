
<!DOCTYPE html>
<html lang="en">
    <style>
/* Stopwatch / Timer local button layout */

#stopwatchSection > div > div:last-child,
#timerSection > div > div:last-child {
    display:grid !important;
    grid-template-columns:repeat(3, 1fr) !important;
    gap:10px !important;
    width:100% !important;
    margin-top:25px !important;
}

#startStopwatch,
#pauseStopwatch,
#resetStopwatch,
#startTimer,
#pauseTimer,
#resetTimer {
    width:100% !important;
    min-width:0 !important;
    height:50px !important;
    min-height:50px !important;
    margin:0 !important;
    box-sizing:border-box !important;
}

/* Start */
#startStopwatch,
#startTimer {
    background:#ef1f2b !important;
    color:#ffffff !important;
    border:1px solid #ef1f2b !important;
}

/* Pause */
#pauseStopwatch,
#pauseTimer {
    background:#64748b !important;
    color:#ffffff !important;
    border:1px solid #64748b !important;
}

/* Reset */
#resetStopwatch,
#resetTimer {
    background:#ffffff !important;
    color:#ef1f2b !important;
    border:1px solid #ef1f2b !important;
    box-shadow:none !important;
}

#resetStopwatch:hover,
#resetTimer:hover {
    background:#fff5f5 !important;
}

@media (max-width:600px) {
    #stopwatchSection > div > div:last-child,
    #timerSection > div > div:last-child {
        grid-template-columns:1fr !important;
    }
}
</style>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Stopwatch & Timer - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">
</head>

<body>
<%- include("partials/tool-header") %>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    ⏱
                </div>

                <h1>Stopwatch & Timer</h1>

                <p>
                    Use a simple stopwatch or countdown timer directly in your browser.
                </p>

            </div>


            <!-- MODE BUTTONS -->

            <div
                style="
                    display:flex;
                    gap:10px;
                    margin-bottom:25px;
                "
            >

                <button
                    type="button"
                    id="stopwatchTab"
                    class="convert-btn"
                    style="margin-top:0;"
                    aria-pressed="true"
                >
                    Stopwatch
                </button>

                <button
                    type="button"
                    id="timerTab"
                    class="convert-btn"
                    style="
                        margin-top:0;
                        background:#64748b !important;
                    "
                    aria-pressed="false"
                >
                    Countdown Timer
                </button>

            </div>


            <!-- STOPWATCH -->

            <div id="stopwatchSection">

                <div
                    style="
                        padding:30px 20px;
                        background:#f8fafc;
                        border:1px solid #e5e7eb;
                        border-radius:16px;
                    "
                >

                    <div
                        id="stopwatchDisplay"
                        style="
                            font-size:48px;
                            font-weight:800;
                            color:#111827;
                            letter-spacing:2px;
                        "
                    >
                        00:00:00.00
                    </div>


                    <div
                        style="
                            display:flex;
                            justify-content:center;
                            gap:10px;
                            flex-wrap:wrap;
                            margin-top:25px;
                        "
                    >

                        <button
                            type="button"
                            id="startStopwatch"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                            "
                        >
                            Start
                        </button>

                        <button
                            type="button"
                            id="pauseStopwatch"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                                background:#f59e0b;
                            "
                        >
                            Pause
                        </button>

                        <button
                            type="button"
                            id="resetStopwatch"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                                background:#ef4444;
                            "
                        >
                            Reset
                        </button>

                    </div>

                </div>

            </div>


            <!-- TIMER -->

            <div
                id="timerSection"
                style="display:none;"
            >

                <div
                    style="
                        padding:30px 20px;
                        background:#f8fafc;
                        border:1px solid #e5e7eb;
                        border-radius:16px;
                    "
                >

                    <div
                        style="
                            display:grid;
                            grid-template-columns:1fr 1fr 1fr;
                            gap:12px;
                        "
                    >

                        <div>

                            <label
                                style="
                                    display:block;
                                    margin-bottom:8px;
                                    font-weight:700;
                                    color:#111827;
                                "
                            >
                                Hours
                            </label>

                            <input
                                type="number"
                                id="hoursInput"
                                value="0"
                                min="0"
                                max="99"
                                style="
                                    width:100%;
                                    padding:14px;
                                    border:1px solid #cbd5e1;
                                    border-radius:10px;
                                    font-size:18px;
                                    text-align:center;
                                    box-sizing:border-box;
                                "
                            >

                        </div>


                        <div>

                            <label
                                style="
                                    display:block;
                                    margin-bottom:8px;
                                    font-weight:700;
                                    color:#111827;
                                "
                            >
                                Minutes
                            </label>

                            <input
                                type="number"
                                id="minutesInput"
                                value="5"
                                min="0"
                                max="59"
                                style="
                                    width:100%;
                                    padding:14px;
                                    border:1px solid #cbd5e1;
                                    border-radius:10px;
                                    font-size:18px;
                                    text-align:center;
                                    box-sizing:border-box;
                                "
                            >

                        </div>


                        <div>

                            <label
                                style="
                                    display:block;
                                    margin-bottom:8px;
                                    font-weight:700;
                                    color:#111827;
                                "
                            >
                                Seconds
                            </label>

                            <input
                                type="number"
                                id="secondsInput"
                                value="0"
                                min="0"
                                max="59"
                                style="
                                    width:100%;
                                    padding:14px;
                                    border:1px solid #cbd5e1;
                                    border-radius:10px;
                                    font-size:18px;
                                    text-align:center;
                                    box-sizing:border-box;
                                "
                            >

                        </div>

                    </div>


                    <div
                        id="timerDisplay"
                        style="
                            margin-top:30px;
                            font-size:48px;
                            font-weight:800;
                            color:#111827;
                            letter-spacing:2px;
                        "
                    >
                        00:05:00
                    </div>


                    <div
                        style="
                            display:flex;
                            justify-content:center;
                            gap:10px;
                            flex-wrap:wrap;
                            margin-top:25px;
                        "
                    >

                        <button
                            type="button"
                            id="startTimer"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                            "
                        >
                            Start
                        </button>

                        <button
                            type="button"
                            id="pauseTimer"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                                background:#f59e0b;
                            "
                        >
                            Pause
                        </button>

                        <button
                            type="button"
                            id="resetTimer"
                            class="convert-btn"
                            style="
                                width:auto;
                                margin-top:0;
                                background:#ef4444;
                            "
                        >
                            Reset
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

/* =========================
   MODE SWITCHING
========================= */

const stopwatchTab =
    document.getElementById("stopwatchTab");

const timerTab =
    document.getElementById("timerTab");

const stopwatchSection =
    document.getElementById("stopwatchSection");

const timerSection =
    document.getElementById("timerSection");


stopwatchTab.addEventListener("click", () => {

    stopwatchSection.style.display = "block";
    timerSection.style.display = "none";

    stopwatchTab.style.setProperty("background", "#ef1f2b", "important");
    timerTab.style.setProperty("background", "#64748b", "important");
    stopwatchTab.setAttribute("aria-pressed", "true");
    timerTab.setAttribute("aria-pressed", "false");

});


timerTab.addEventListener("click", () => {

    stopwatchSection.style.display = "none";
    timerSection.style.display = "block";

    stopwatchTab.style.setProperty("background", "#64748b", "important");
    timerTab.style.setProperty("background", "#ef1f2b", "important");
    stopwatchTab.setAttribute("aria-pressed", "false");
    timerTab.setAttribute("aria-pressed", "true");

});


/* =========================
   STOPWATCH
========================= */

let stopwatchInterval = null;

let stopwatchStartTime = 0;

let stopwatchElapsed = 0;


const stopwatchDisplay =
    document.getElementById("stopwatchDisplay");


function formatStopwatch(ms) {

    const totalCentiseconds =
        Math.floor(ms / 10);

    const centiseconds =
        totalCentiseconds % 100;

    const totalSeconds =
        Math.floor(totalCentiseconds / 100);

    const seconds =
        totalSeconds % 60;

    const totalMinutes =
        Math.floor(totalSeconds / 60);

    const minutes =
        totalMinutes % 60;

    const hours =
        Math.floor(totalMinutes / 60);


    return (
        String(hours).padStart(2, "0") +
        ":" +
        String(minutes).padStart(2, "0") +
        ":" +
        String(seconds).padStart(2, "0") +
        "." +
        String(centiseconds).padStart(2, "0")
    );

}


function updateStopwatch() {

    stopwatchElapsed =
        Date.now() - stopwatchStartTime;

    stopwatchDisplay.textContent =
        formatStopwatch(stopwatchElapsed);

}


document
    .getElementById("startStopwatch")
    .addEventListener("click", () => {

        if (stopwatchInterval) {
            return;
        }

        stopwatchStartTime =
            Date.now() - stopwatchElapsed;

        stopwatchInterval =
            setInterval(updateStopwatch, 10);

    });


document
    .getElementById("pauseStopwatch")
    .addEventListener("click", () => {

        if (!stopwatchInterval) {
            return;
        }

        clearInterval(stopwatchInterval);

        stopwatchInterval = null;

        updateStopwatch();

    });


document
    .getElementById("resetStopwatch")
    .addEventListener("click", () => {

        clearInterval(stopwatchInterval);

        stopwatchInterval = null;

        stopwatchElapsed = 0;

        stopwatchDisplay.textContent =
            "00:00:00.00";

    });


/* =========================
   COUNTDOWN TIMER
========================= */

let timerInterval = null;

let timerRemaining = 0;


const hoursInput =
    document.getElementById("hoursInput");

const minutesInput =
    document.getElementById("minutesInput");

const secondsInput =
    document.getElementById("secondsInput");

const timerDisplay =
    document.getElementById("timerDisplay");


function formatTimer(totalSeconds) {

    const hours =
        Math.floor(totalSeconds / 3600);

    const minutes =
        Math.floor((totalSeconds % 3600) / 60);

    const seconds =
        totalSeconds % 60;


    return (
        String(hours).padStart(2, "0") +
        ":" +
        String(minutes).padStart(2, "0") +
        ":" +
        String(seconds).padStart(2, "0")
    );

}


function updateTimerDisplay() {

    timerDisplay.textContent =
        formatTimer(timerRemaining);

}


function getTimerInputSeconds() {

    const hours =
        Number(hoursInput.value) || 0;

    const minutes =
        Number(minutesInput.value) || 0;

    const seconds =
        Number(secondsInput.value) || 0;


    return (
        hours * 3600 +
        minutes * 60 +
        seconds
    );

}


function stopTimer() {

    clearInterval(timerInterval);

    timerInterval = null;

}


document
    .getElementById("startTimer")
    .addEventListener("click", () => {

        if (timerInterval) {
            return;
        }


        if (timerRemaining <= 0) {

            timerRemaining =
                getTimerInputSeconds();

        }


        if (timerRemaining <= 0) {

            alert("Please enter a timer duration.");

            return;
        }


        updateTimerDisplay();


        timerInterval =
            setInterval(() => {

                timerRemaining--;

                updateTimerDisplay();


                if (timerRemaining <= 0) {

                    stopTimer();

                    timerRemaining = 0;

                    updateTimerDisplay();

                    alert("Time is up! ⏰");

                }

            }, 1000);

    });


document
    .getElementById("pauseTimer")
    .addEventListener("click", () => {

        stopTimer();

    });


document
    .getElementById("resetTimer")
    .addEventListener("click", () => {

        stopTimer();

        timerRemaining =
            getTimerInputSeconds();

        updateTimerDisplay();

    });


hoursInput.addEventListener("input", () => {

    if (!timerInterval) {

        timerRemaining =
            getTimerInputSeconds();

        updateTimerDisplay();

    }

});


minutesInput.addEventListener("input", () => {

    if (!timerInterval) {

        timerRemaining =
            getTimerInputSeconds();

        updateTimerDisplay();

    }

});


secondsInput.addEventListener("input", () => {

    if (!timerInterval) {

        timerRemaining =
            getTimerInputSeconds();

        updateTimerDisplay();

    }

});


updateTimerDisplay();

</script>

