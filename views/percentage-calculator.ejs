<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Percentage Calculator - FileVora</title>
    <meta name="description" content="Calculate percentages quickly and easily with FileVora Percentage Calculator.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="converter-page">
        <div class="container">

            <div class="converter-card">

                <div class="converter-header">

                    <div class="tool-icon">
                        %
                    </div>

                    <h1>Percentage Calculator</h1>

                    <p>
                        Calculate percentages, percentage changes and percentage differences easily.
                    </p>

                </div>

                <!-- Calculator 1 -->

                <div
                    style="
                        text-align:left;
                        padding:20px;
                        margin-bottom:18px;
                        background:#f8fafc;
                        border:1px solid #e2e8f0;
                        border-radius:14px;
                    "
                >

                    <h2
                        style="
                            margin:0 0 16px;
                            font-size:19px;
                            color:#111827;
                        "
                    >
                        What is X% of Y?
                    </h2>

                    <input
                        type="number"
                        id="percent1"
                        placeholder="Percentage (X)"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:10px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <input
                        type="number"
                        id="number1"
                        placeholder="Number (Y)"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:12px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <button
                        class="convert-btn"
                        type="button"
                        onclick="calculatePercentage()"
                    >
                        Calculate
                    </button>

                    <div
                        id="answer1"
                        style="
                            display:none;
                            margin-top:14px;
                            padding:14px;
                            background:#ffffff;
                            border-radius:10px;
                            color:#166534;
                            font-weight:700;
                        "
                    ></div>

                </div>


                <!-- Calculator 2 -->

                <div
                    style="
                        text-align:left;
                        padding:20px;
                        margin-bottom:18px;
                        background:#f8fafc;
                        border:1px solid #e2e8f0;
                        border-radius:14px;
                    "
                >

                    <h2
                        style="
                            margin:0 0 16px;
                            font-size:19px;
                            color:#111827;
                        "
                    >
                        X is what % of Y?
                    </h2>

                    <input
                        type="number"
                        id="number2"
                        placeholder="Number (X)"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:10px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <input
                        type="number"
                        id="number3"
                        placeholder="Number (Y)"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:12px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <button
                        class="convert-btn"
                        type="button"
                        onclick="calculateWhatPercent()"
                    >
                        Calculate
                    </button>

                    <div
                        id="answer2"
                        style="
                            display:none;
                            margin-top:14px;
                            padding:14px;
                            background:#ffffff;
                            border-radius:10px;
                            color:#166534;
                            font-weight:700;
                        "
                    ></div>

                </div>


                <!-- Calculator 3 -->

                <div
                    style="
                        text-align:left;
                        padding:20px;
                        margin-bottom:18px;
                        background:#f8fafc;
                        border:1px solid #e2e8f0;
                        border-radius:14px;
                    "
                >

                    <h2
                        style="
                            margin:0 0 16px;
                            font-size:19px;
                            color:#111827;
                        "
                    >
                        Percentage Change
                    </h2>

                    <input
                        type="number"
                        id="oldValue"
                        placeholder="Original Value"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:10px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <input
                        type="number"
                        id="newValue"
                        placeholder="New Value"
                        style="
                            width:100%;
                            padding:13px;
                            margin-bottom:12px;
                            border:1px solid #cbd5e1;
                            border-radius:10px;
                            box-sizing:border-box;
                        "
                    >

                    <button
                        class="convert-btn"
                        type="button"
                        onclick="calculateChange()"
                    >
                        Calculate Change
                    </button>

                    <div
                        id="answer3"
                        style="
                            display:none;
                            margin-top:14px;
                            padding:14px;
                            background:#ffffff;
                            border-radius:10px;
                            color:#166534;
                            font-weight:700;
                        "
                    ></div>

                </div>


                <div
                    class="result"
                    id="result"
                    style="display:block; text-align:left;"
                >

                    <h2>Quick Examples</h2>

                    <p style="margin-top:8px;">
                        20% of 150 = 30
                    </p>

                    <p style="margin-top:8px;">
                        25 is 50% of 50
                    </p>

                    <p style="margin-top:8px;">
                        From 100 to 120 = 20% increase
                    </p>

                </div>

            </div>

        </div>
    </main>


    <script>

        function calculatePercentage() {

            const percent =
                parseFloat(
                    document.getElementById("percent1").value
                );

            const number =
                parseFloat(
                    document.getElementById("number1").value
                );

            const answer =
                document.getElementById("answer1");

            if (
                isNaN(percent) ||
                isNaN(number)
            ) {

                alert("Please enter both values.");

                return;
            }

            const result =
                (percent / 100) * number;

            answer.textContent =
                percent + "% of " +
                number +
                " = " +
                formatNumber(result);

            answer.style.display = "block";
        }


        function calculateWhatPercent() {

            const x =
                parseFloat(
                    document.getElementById("number2").value
                );

            const y =
                parseFloat(
                    document.getElementById("number3").value
                );

            const answer =
                document.getElementById("answer2");

            if (
                isNaN(x) ||
                isNaN(y)
            ) {

                alert("Please enter both values.");

                return;
            }

            if (y === 0) {

                alert("The second value cannot be zero.");

                return;
            }

            const result =
                (x / y) * 100;

            answer.textContent =
                x +
                " is " +
                formatNumber(result) +
                "% of " +
                y;

            answer.style.display = "block";
        }


        function calculateChange() {

            const oldValue =
                parseFloat(
                    document.getElementById("oldValue").value
                );

            const newValue =
                parseFloat(
                    document.getElementById("newValue").value
                );

            const answer =
                document.getElementById("answer3");

            if (
                isNaN(oldValue) ||
                isNaN(newValue)
            ) {

                alert("Please enter both values.");

                return;
            }

            if (oldValue === 0) {

                alert(
                    "Original value cannot be zero."
                );

                return;
            }

            const change =
                ((newValue - oldValue) /
                    Math.abs(oldValue)) *
                100;

            const rounded =
                formatNumber(Math.abs(change));

            if (change > 0) {

                answer.textContent =
                    "Increase: " +
                    rounded +
                    "%";

            } else if (change < 0) {

                answer.textContent =
                    "Decrease: " +
                    rounded +
                    "%";

            } else {

                answer.textContent =
                    "No percentage change: 0%";
            }

            answer.style.display = "block";
        }


        function formatNumber(number) {

            return Number(
                number.toFixed(6)
            ).toLocaleString();

        }

    </script>

</body>
</html>