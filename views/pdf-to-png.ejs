<body class="pdf-tool">

<%- include("partials/tool-header") %>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    PDF
                </div>

                <h1>PDF to PNG</h1>

                <p>
                    Convert your PDF pages into high-quality PNG images instantly.
                </p>

            </div>


            <label class="upload-area" for="pdfInput">

                <div class="upload-icon">ðŸ“„</div>

                <strong>Choose a PDF file</strong>

                <span>PDF files only</span>

            </label>


            <input
                id="pdfInput"
                type="file"
                accept="application/pdf,.pdf"
            >


            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <button
                class="convert-btn"
                id="convertBtn"
                disabled
            >
                Convert to PNG
            </button>


            <div class="result" id="result">

                <h2>PNG Ready</h2>

                <p id="resultText">
                    Your PDF pages have been converted successfully.
                </p>

