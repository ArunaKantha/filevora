<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Image Rotator - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">
</head>

<body>
<%- include("partials/tool-header") %>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    ↻
                </div>

                <h1>Image Rotator</h1>

                <p>
                    Rotate your images easily by 90°, 180°, or 270°.
                </p>

            </div>


            <!-- Upload -->

            <label class="upload-area" for="imageInput">

                <div class="upload-icon">
                    🖼️
                </div>

                <strong>Click to upload an image</strong>

                <span>
                    JPG, PNG, WEBP and other common image formats
                </span>

                <input
                    type="file"
                    id="imageInput"
                    accept="image/*"
                >

            </label>


            <!-- File Info -->

            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <!-- Preview -->

            <div
                id="previewArea"
                style="display:none; margin-top:25px;"
            >

                <canvas
                    id="previewCanvas"
                    style="
                        max-width:100%;
                        height:auto;
                        border-radius:12px;
                    "
                ></canvas>

            </div>


            <!-- Rotation Controls -->

            <div
                id="rotationControls"
                style="display:none; margin-top:22px;"
            >

                <div
                    style="
                        display:flex;
                        justify-content:center;
                        gap:10px;
                        flex-wrap:wrap;
                    "
                >

                    <button
                        type="button"
                        class="convert-btn"
                        id="rotateLeft"
                        style="width:auto; margin-top:0;"
                    >
                        ↶ 90° Left
                    </button>

                    <button
                        type="button"
                        class="convert-btn"
                        id="rotateRight"
                        style="width:auto; margin-top:0;"
                    >
                        ↷ 90° Right
                    </button>

                    <button
                        type="button"
                        class="convert-btn"
                        id="rotate180"
                        style="width:auto; margin-top:0;"
                    >
                        ⟳ 180°
                    </button>

                </div>

            </div>


            <!-- Output Format -->

            <div
                id="formatArea"
                style="display:none; margin-top:20px;"
            >

                <label for="formatSelect">
                    Output Format
                </label>

                <select
                    id="formatSelect"
                    style="
                        margin-left:8px;
                        padding:9px 12px;
                        border:1px solid #cbd5e1;
                        border-radius:8px;
                        background:#fff;
                    "
                >

                    <option value="image/jpeg">
                        JPG
                    </option>

                    <option value="image/png">
                        PNG
                    </option>

                    <option value="image/webp">
                        WEBP
                    </option>

                </select>

            </div>


            <!-- Main Button -->

            <div id="rotatorActions">
    <button
        type="button"
        class="convert-btn"
        id="downloadBtn"
        disabled
    >
        Download Rotated Image
    </button>

    <button
        type="button"
        id="rotatorResetBtn"
    >
        Reset
    </button>
</div>


            <!-- Result -->

            <div
                class="result"
                id="result"
            >

                <h2>Image Ready</h2>

                <p>
                    Your rotated image is ready to download.
                </p>

                <a
                    class="download-btn"
                    id="downloadLink"
                    href="#"
                    download
                >
                    Download Image
                </a>

            </div>

        </div>

    </div>

</div>


<script>

const imageInput =
    document.getElementById("imageInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const previewArea =
    document.getElementById("previewArea");

const previewCanvas =
    document.getElementById("previewCanvas");

const rotationControls =
    document.getElementById("rotationControls");

const formatArea =
    document.getElementById("formatArea");

const formatSelect =
    document.getElementById("formatSelect");

const downloadBtn =
    document.getElementById("downloadBtn");
    const rotatorActions =
    document.getElementById("rotatorActions");
    const rotatorResetBtn =
    document.getElementById("rotatorResetBtn");

const result =
    document.getElementById("result");

const downloadLink =
    document.getElementById("downloadLink");

const rotateLeft =
    document.getElementById("rotateLeft");

const rotateRight =
    document.getElementById("rotateRight");

const rotate180 =
    document.getElementById("rotate180");


const ctx =
    previewCanvas.getContext("2d");


let image = null;

let rotation = 0;

let originalFile = null;


/*
    Upload
*/

imageInput.addEventListener(
    "change",
    function () {

        const file =
            this.files[0];

        if (!file) {
            return;
        }

        originalFile = file;

        const reader =
            new FileReader();

        reader.onload =
            function (event) {

                const img =
                    new Image();

                img.onload =
                    function () {

                        image = img;

                        rotation = 0;

                        fileName.textContent =
                            file.name;

                        fileSize.textContent =
                            formatFileSize(file.size);

                        fileInfo.style.display =
                            "block";

                        previewArea.style.display =
                            "block";

                        rotationControls.style.display =
                            "block";

                        formatArea.style.display =
                            "block";

                        result.style.display =
                            "none";

                        downloadBtn.disabled =
                            false;
                            rotatorActions.style.display = "grid";

                        drawPreview();

                    };

                img.src =
                    event.target.result;
            };

        reader.readAsDataURL(file);

    }
);


/*
    File Size
*/

function formatFileSize(bytes) {

    if (bytes < 1024) {
        return bytes + " B";
    }

    if (bytes < 1024 * 1024) {
        return (
            (bytes / 1024).toFixed(1) +
            " KB"
        );
    }

    return (
        (bytes / (1024 * 1024)).toFixed(2) +
        " MB"
    );
}


/*
    Draw rotated preview
*/

function drawPreview() {

    if (!image) {
        return;
    }

    const angle =
        ((rotation % 360) + 360) % 360;

    const radians =
        angle * Math.PI / 180;


    if (angle === 90 || angle === 270) {

        previewCanvas.width =
            image.naturalHeight;

        previewCanvas.height =
            image.naturalWidth;

    } else {

        previewCanvas.width =
            image.naturalWidth;

        previewCanvas.height =
            image.naturalHeight;

    }


    ctx.clearRect(
        0,
        0,
        previewCanvas.width,
        previewCanvas.height
    );


    ctx.save();

    ctx.translate(
        previewCanvas.width / 2,
        previewCanvas.height / 2
    );

    ctx.rotate(radians);

    ctx.drawImage(
        image,
        -image.naturalWidth / 2,
        -image.naturalHeight / 2
    );

    ctx.restore();

}


/*
    Rotate Left
*/

rotateLeft.addEventListener(
    "click",
    function () {

        rotation -= 90;

        drawPreview();

    }
);


/*
    Rotate Right
*/

rotateRight.addEventListener(
    "click",
    function () {

        rotation += 90;

        drawPreview();

    }
);


/*
    Rotate 180
*/

rotate180.addEventListener(
    "click",
    function () {

        rotation += 180;

        drawPreview();

    }
);


/*
    Download
*/

downloadBtn.addEventListener(
    "click",
    function () {

        if (!image) {
            return;
        }

        const format =
            formatSelect.value;

        const quality =
            format === "image/png"
                ? 1
                : 0.92;


        previewCanvas.toBlob(
            function (blob) {

                if (!blob) {

                    alert(
                        "Could not create the image."
                    );

                    return;
                }


                const url =
                    URL.createObjectURL(blob);


                let extension =
                    "jpg";

                if (
                    format ===
                    "image/png"
                ) {
                    extension = "png";
                }

                if (
                    format ===
                    "image/webp"
                ) {
                    extension = "webp";
                }


                downloadLink.href =
                    url;

                downloadLink.download =
                    "filevora-rotated-image." +
                    extension;


                result.style.display =
                    "block";


                result.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

            },
            format,
            quality
        );

    }
);

rotatorResetBtn.addEventListener("click", function () {
    window.location.reload();
});

</script>

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a class="brand" href="/"><span class="brand-mark">F</span><span class="brand-name">File<span>Vora</span></span></a><p>Fast, simple online tools for everyday file tasks.</p></div>
    <div><h3>Company</h3><a href="/about">About Us</a><a href="/contact">Contact Us</a><a href="/security">Security</a></div>
    <div><h3>Resources</h3><a href="/blog">Blog</a><a href="/#tools">Tools</a><a href="/faq">FAQ</a></div>
    <div><h3>Legal</h3><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a><a href="/disclaimer">Disclaimer</a></div>
    <div><h3>Contact</h3><a href="/contact">Email</a><a href="/contact">Facebook</a><a href="/contact">Instagram</a></div>
  </div>
  <div class="container footer-bottom"><span>© <span data-current-year></span> FileVora. All rights reserved.</span><span>All in One Tool.</span></div>
</footer>
<script>document.querySelectorAll('[data-current-year]').forEach(el=>el.textContent=new Date().getFullYear());</script>

<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>

