<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JSON Validator - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

    <style>
        .json-validator-action-row{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
            margin-top:18px;
        }

        .json-validator-action-row .convert-btn{
            width:100% !important;
            height:50px !important;
            min-height:50px !important;
            margin:0 !important;
            box-sizing:border-box !important;
        }

        .json-validator-reset-btn{
            background:#ffffff !important;
            color:#00bc8a !important;
            border:1px solid #00bc8a !important;
            box-shadow:none !important;
        }

        .json-validator-reset-btn:hover{
            background:#ecfdf8 !important;
        }

        .json-validator-result-actions{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
            margin-top:15px;
        }

        .json-validator-result-actions .download-btn{
            width:100% !important;
            margin:0 !important;
            box-sizing:border-box !important;
        }

        @media (max-width:600px){
            .json-validator-action-row,
            .json-validator-result-actions{
                grid-template-columns:1fr;
            }
        }
    </style>
</head>

<body>

<%- include("partials/tool-header") %>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    JV
                </div>

                <h1>JSON Validator</h1>

                <p>
                    Check whether your JSON is valid and find syntax errors instantly.
                </p>

            </div>


            <textarea
                id="jsonInput"
                placeholder='Paste your JSON here...&#10;&#10;Example: {"name":"FileVora","tools":29}'
                style="
                    width:100%;
                    min-height:280px;
                    padding:18px;
                    border:2px solid #e5e7eb;
                    border-radius:14px;
                    resize:vertical;
                    font-size:15px;
                    line-height:1.6;
                    outline:none;
                    font-family:monospace;
                    box-sizing:border-box;
                "
            ></textarea>


            <div class="json-validator-action-row">

                <button
                    type="button"
                    class="convert-btn"
                    id="validateBtn"
                >
                    Validate JSON
                </button>

                <button
                    type="button"
                    class="convert-btn json-validator-reset-btn"
                    id="resetBtn"
                >
                    Reset
                </button>

            </div>


            <div
                class="result"
                id="result"
                style="display:none;"
            >

                <h2 id="resultTitle"></h2>

                <p id="resultInfo"></p>


                <div
                    id="errorBox"
                    style="
                        display:none;
                        margin-top:18px;
                        padding:16px;
                        background:#fff1f2;
                        border:1px solid #fecdd3;
                        border-radius:10px;
                        text-align:left;
                        color:#9f1239;
                        font-family:monospace;
                        font-size:14px;
                        line-height:1.6;
                        word-break:break-word;
                    "
                ></div>


                <textarea
                    id="outputText"
                    readonly
                    style="
                        display:none;
                        width:100%;
                        min-height:240px;
                        margin-top:18px;
                        padding:16px;
                        border:1px solid #cbd5e1;
                        border-radius:10px;
                        resize:vertical;
                        font-size:14px;
                        line-height:1.6;
                        font-family:monospace;
                        box-sizing:border-box;
                        background:#ffffff;
                    "
                ></textarea>


                <div
                    class="json-validator-result-actions"
                    id="resultActions"
                    style="display:none;"
                >

                    <button
                        type="button"
                        class="download-btn"
                        id="copyBtn"
                    >
                        Copy JSON
                    </button>

                    <button
                        type="button"
                        class="download-btn"
                        id="downloadBtn"
                    >
                        Download JSON
                    </button>

                </div>

            </div>

        </div>

    </div>

</main>


<script>

const jsonInput =
    document.getElementById("jsonInput");

const validateBtn =
    document.getElementById("validateBtn");

const resetBtn =
    document.getElementById("resetBtn");

const result =
    document.getElementById("result");

const resultTitle =
    document.getElementById("resultTitle");

const resultInfo =
    document.getElementById("resultInfo");

const errorBox =
    document.getElementById("errorBox");

const outputText =
    document.getElementById("outputText");

const resultActions =
    document.getElementById("resultActions");

const copyBtn =
    document.getElementById("copyBtn");

const downloadBtn =
    document.getElementById("downloadBtn");


let validJson =
    "";


/* =========================
   VALIDATE JSON
========================= */

validateBtn.addEventListener(
    "click",
    function () {

        const input =
            jsonInput.value.trim();


        if (!input) {

            alert(
                "Please paste some JSON first."
            );

            return;
        }


        validJson =
            "";


        result.style.display =
            "block";


        errorBox.style.display =
            "none";


        outputText.style.display =
            "none";


        resultActions.style.display =
            "none";


        try {

            const parsed =
                JSON.parse(input);


            validJson =
                JSON.stringify(
                    parsed,
                    null,
                    2
                );


            resultTitle.textContent =
                "Valid JSON";


            resultInfo.textContent =
                "Your JSON syntax is correct and can be parsed successfully.";


            result.style.background =
                "#f0fdf4";


            result.style.borderColor =
                "#bbf7d0";


            outputText.value =
                validJson;


            outputText.style.display =
                "block";


            resultActions.style.display =
                "grid";


        } catch (error) {

            validJson =
                "";


            resultTitle.textContent =
                "Invalid JSON";


            resultInfo.textContent =
                "Your JSON contains a syntax error.";


            result.style.background =
                "#fef2f2";


            result.style.borderColor =
                "#fecaca";


            outputText.value =
                "";


            outputText.style.display =
                "none";


            resultActions.style.display =
                "none";


            errorBox.style.display =
                "block";


            errorBox.textContent =
                "Error: " +
                error.message;
        }


        result.scrollIntoView({
            behavior:"smooth",
            block:"nearest"
        });

    }
);


/* =========================
   COPY JSON
========================= */

copyBtn.addEventListener(
    "click",
    async function () {

        if (!validJson) {
            return;
        }


        try {

            await navigator.clipboard.writeText(
                validJson
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy JSON";

                },
                1500
            );


        } catch (error) {

            outputText.select();


            document.execCommand(
                "copy"
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy JSON";

                },
                1500
            );
        }

    }
);


/* =========================
   DOWNLOAD JSON
========================= */

downloadBtn.addEventListener(
    "click",
    function () {

        if (!validJson) {

            alert(
                "Please validate JSON first."
            );

            return;
        }


        const blob =
            new Blob(
                [validJson],
                {
                    type:
                        "application/json;charset=utf-8;"
                }
            );


        const url =
            URL.createObjectURL(
                blob
            );


        const link =
            document.createElement(
                "a"
            );


        link.href =
            url;


        link.download =
            "filevora-valid.json";


        document.body.appendChild(
            link
        );


        link.click();


        document.body.removeChild(
            link
        );


        URL.revokeObjectURL(
            url
        );

    }
);


/* =========================
   RESET
========================= */

resetBtn.addEventListener(
    "click",
    function () {

        jsonInput.value =
            "";


        validJson =
            "";


        resultTitle.textContent =
            "";


        resultInfo.textContent =
            "";


        errorBox.textContent =
            "";


        errorBox.style.display =
            "none";


        outputText.value =
            "";


        outputText.style.display =
            "none";


        resultActions.style.display =
            "none";


        result.style.display =
            "none";


        result.style.background =
            "";


        result.style.borderColor =
            "";


        copyBtn.textContent =
            "Copy JSON";


        downloadBtn.textContent =
            "Download JSON";


        jsonInput.focus();

    }
);

</script>


<footer class="site-footer">

  <div class="container footer-grid">

    <div class="footer-brand">

        <a class="brand" href="/">
            <span class="brand-mark">F</span>
            <span class="brand-name">File<span>Vora</span></span>
        </a>

        <p>
            Fast, simple online tools for everyday file tasks.
        </p>

    </div>

    <div>
        <h3>Company</h3>
        <a href="/about">About Us</a>
        <a href="/contact">Contact Us</a>
        <a href="/security">Security</a>
    </div>

    <div>
        <h3>Resources</h3>
        <a href="/blog">Blog</a>
        <a href="/#tools">Tools</a>
        <a href="/faq">FAQ</a>
    </div>

    <div>
        <h3>Legal</h3>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/disclaimer">Disclaimer</a>
    </div>

    <div>
        <h3>Contact</h3>
        <a href="/contact">Email</a>
        <a href="/contact">Facebook</a>
        <a href="/contact">Instagram</a>
    </div>

  </div>


  <div class="container footer-bottom">

    <span>
        © <span data-current-year></span> FileVora. All rights reserved.
    </span>

    <span>
        All in One Tool.
    </span>

  </div>

</footer>


<script>
document
    .querySelectorAll("[data-current-year]")
    .forEach(function (element) {

        element.textContent =
            new Date().getFullYear();

    });
</script>


<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>