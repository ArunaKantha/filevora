<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lorem Ipsum Generator - FileVora</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<main class="converter-page">
    <div class="container">
        <div class="converter-card">

            <div class="converter-header">
                <div class="tool-icon">LI</div>
                <h1>Lorem Ipsum Generator</h1>
                <p>Generate placeholder Lorem Ipsum text for websites, designs, and projects.</p>
            </div>

            <div style="text-align:left; margin-bottom:20px;">
                <label for="countType" style="display:block; margin-bottom:8px; font-weight:700; color:#111827;">
                    Generate By
                </label>

                <select
                    id="countType"
                    style="
                        width:100%;
                        padding:13px 15px;
                        border:1px solid #cbd5e1;
                        border-radius:10px;
                        font-size:15px;
                        background:#fff;
                        box-sizing:border-box;
                    "
                >
                    <option value="paragraphs">Paragraphs</option>
                    <option value="sentences">Sentences</option>
                    <option value="words">Words</option>
                </select>
            </div>

            <div style="text-align:left;">
                <label for="count" style="display:block; margin-bottom:8px; font-weight:700; color:#111827;">
                    Number
                </label>

                <input
                    type="number"
                    id="count"
                    value="3"
                    min="1"
                    max="50"
                    style="
                        width:100%;
                        padding:13px 15px;
                        border:1px solid #cbd5e1;
                        border-radius:10px;
                        font-size:15px;
                        box-sizing:border-box;
                        outline:none;
                    "
                >
            </div>

            <button class="convert-btn" id="generateBtn">
                Generate Lorem Ipsum
            </button>

            <div class="result" id="result">
                <h2>Your Lorem Ipsum</h2>
                <p id="resultInfo">Generated successfully.</p>

                <textarea
                    id="outputText"
                    readonly
                    style="
                        width:100%;
                        min-height:280px;
                        margin-top:18px;
                        padding:16px;
                        border:1px solid #d1d5db;
                        border-radius:10px;
                        resize:vertical;
                        font-size:15px;
                        line-height:1.7;
                        font-family:inherit;
                        box-sizing:border-box;
                        background:#ffffff;
                    "
                ></textarea>

                <button class="download-btn" id="copyBtn">
                    Copy Text
                </button>
            </div>

        </div>
    </div>
</main>

<script>
const words = [
    "lorem", "ipsum", "dolor", "sit", "amet", "consectetur",
    "adipiscing", "elit", "sed", "do", "eiusmod", "tempor",
    "incididunt", "ut", "labore", "et", "dolore", "magna",
    "aliqua", "enim", "ad", "minim", "veniam", "quis",
    "nostrud", "exercitation", "ullamco", "laboris", "nisi",
    "aliquip", "ex", "ea", "commodo", "consequat", "duis",
    "aute", "irure", "reprehenderit", "voluptate", "velit",
    "esse", "cillum", "fugiat", "nulla", "pariatur",
    "excepteur", "sint", "occaecat", "cupidatat", "non",
    "proident", "sunt", "culpa", "qui", "officia", "deserunt",
    "mollit", "anim", "id", "est", "laborum"
];

function randomWord() {
    return words[Math.floor(Math.random() * words.length)];
}

function generateWords(count) {
    const result = [];

    for (let i = 0; i < count; i++) {
        result.push(randomWord());
    }

    return result;
}

function generateSentence() {
    const length = Math.floor(Math.random() * 10) + 8;
    const sentenceWords = generateWords(length);

    sentenceWords[0] =
        sentenceWords[0].charAt(0).toUpperCase() +
        sentenceWords[0].slice(1);

    return sentenceWords.join(" ") + ".";
}

function generateSentences(count) {
    const result = [];

    for (let i = 0; i < count; i++) {
        result.push(generateSentence());
    }

    return result;
}

function generateParagraph() {
    const sentenceCount = Math.floor(Math.random() * 4) + 4;
    return generateSentences(sentenceCount).join(" ");
}

function generateParagraphs(count) {
    const result = [];

    for (let i = 0; i < count; i++) {
        result.push(generateParagraph());
    }

    return result.join("\n\n");
}

const generateBtn = document.getElementById("generateBtn");
const countType = document.getElementById("countType");
const countInput = document.getElementById("count");
const result = document.getElementById("result");
const outputText = document.getElementById("outputText");
const resultInfo = document.getElementById("resultInfo");
const copyBtn = document.getElementById("copyBtn");

generateBtn.addEventListener("click", () => {

    let count = parseInt(countInput.value);

    if (isNaN(count) || count < 1) {
        alert("Please enter a valid number.");
        return;
    }

    if (count > 50) {
        count = 50;
        countInput.value = 50;
    }

    let generatedText = "";

    if (countType.value === "words") {
        generatedText = generateWords(count).join(" ");
    }

    if (countType.value === "sentences") {
        generatedText = generateSentences(count).join(" ");
    }

    if (countType.value === "paragraphs") {
        generatedText = generateParagraphs(count);
    }

    outputText.value = generatedText;

    const wordCount = generatedText
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .length;

    resultInfo.textContent =
        `Generated ${count} ${countType.value}. Total words: ${wordCount}`;

    result.style.display = "block";

    result.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
    });
});

copyBtn.addEventListener("click", async () => {

    if (!outputText.value) return;

    try {
        await navigator.clipboard.writeText(outputText.value);

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
            copyBtn.textContent = "Copy Text";
        }, 1500);

    } catch (error) {
        outputText.select();
        document.execCommand("copy");

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
            copyBtn.textContent = "Copy Text";
        }, 1500);
    }
});
</script>

</body>
</html>