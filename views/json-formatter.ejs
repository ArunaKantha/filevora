<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSON Formatter - FileVora</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<main class="converter-page">
    <div class="container">
        <div class="converter-card">

            <div class="converter-header">
                <div class="tool-icon">JF</div>
                <h1>JSON Formatter</h1>
                <p>Format and beautify JSON data instantly with proper indentation.</p>
            </div>

            <textarea
                id="jsonInput"
                placeholder='Paste your JSON here...&#10;&#10;Example: {"name":"FileVora","tools":30}'
                style="
                    width:100%;
                    min-height:260px;
                    padding:18px;
                    border:2px solid #e5e7eb;
                    border-radius:14px;
                    resize:vertical;
                    font-size:15px;
                    line-height:1.6;
                    outline:none;
                    font-family:monospace;
                    box-sizing:border-box;
                "
            ></textarea>

            <div style="
                display:flex;
                gap:12px;
                margin-top:18px;
                text-align:left;
                align-items:center;
            ">
                <label style="font-weight:700; color:#111827;">
                    Indentation:
                </label>

                <select
                    id="indentSize"
                    style="
                        padding:10px 14px;
                        border:1px solid #cbd5e1;
                        border-radius:8px;
                        font-size:14px;
                        background:#fff;
                    "
                >
                    <option value="2">2 spaces</option>
                    <option value="4">4 spaces</option>
                    <option value="8">8 spaces</option>
                    <option value="tab">Tab</option>
                </select>
            </div>

            <button class="convert-btn" id="formatBtn">
                Format JSON
            </button>

            <div class="result" id="result">

                <h2 id="resultTitle">JSON Formatted Successfully</h2>
                <p id="resultInfo"></p>

                <textarea
                    id="outputText"
                    readonly
                    style="
                        width:100%;
                        min-height:280px;
                        margin-top:18px;
                        padding:16px;
                        border:1px solid #d1d5db;
                        border-radius:10px;
                        resize:vertical;
                        font-size:14px;
                        line-height:1.6;
                        font-family:monospace;
                        box-sizing:border-box;
                        background:#ffffff;
                    "
                ></textarea>

                <button class="download-btn" id="copyBtn">
                    Copy JSON
                </button>

            </div>

        </div>
    </div>
</main>

<script>
const jsonInput = document.getElementById("jsonInput");
const formatBtn = document.getElementById("formatBtn");
const indentSize = document.getElementById("indentSize");

const result = document.getElementById("result");
const resultTitle = document.getElementById("resultTitle");
const resultInfo = document.getElementById("resultInfo");
const outputText = document.getElementById("outputText");
const copyBtn = document.getElementById("copyBtn");

formatBtn.addEventListener("click", () => {

    const input = jsonInput.value.trim();

    if (!input) {
        alert("Please paste some JSON first.");
        return;
    }

    try {

        const parsed = JSON.parse(input);

        let indentation = 2;

        if (indentSize.value === "tab") {
            indentation = "\t";
        } else {
            indentation = parseInt(indentSize.value);
        }

        const formatted = JSON.stringify(
            parsed,
            null,
            indentation
        );

        outputText.value = formatted;

        const lines = formatted.split("\n").length;

        resultTitle.textContent = "JSON Formatted Successfully";

        resultInfo.textContent =
            `Valid JSON • ${lines} lines`;

        result.style.display = "block";

        result.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });

    } catch (error) {

        outputText.value = "";

        resultTitle.textContent = "Invalid JSON";

        resultInfo.textContent =
            "Please check your JSON syntax and try again.";

        result.style.display = "block";

        result.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });
    }
});

copyBtn.addEventListener("click", async () => {

    if (!outputText.value) return;

    try {

        await navigator.clipboard.writeText(outputText.value);

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
            copyBtn.textContent = "Copy JSON";
        }, 1500);

    } catch (error) {

        outputText.select();
        document.execCommand("copy");

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
            copyBtn.textContent = "Copy JSON";
        }, 1500);
    }
});
</script>

</body>
</html>