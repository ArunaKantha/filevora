<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PDF Crop - FileVora</title>
    <meta
        name="description"
        content="Crop PDF pages online with FileVora. Adjust PDF margins quickly and easily."
    >

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .crop-options {
            margin-top: 22px;
            text-align: left;
        }

        .crop-options label {
            display: block;
