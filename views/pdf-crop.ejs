                    </select>

                    <div class="custom-fields" id="customFields">

                        <div class="custom-field">
                            <span>Top %</span>
                            <input
                                class="custom-input"
                                type="number"
                                id="topMargin"
                                value="10"
                                min="0"
                                max="45"
                            >
                        </div>

                        <div class="custom-field">
                            <span>Right %</span>
                            <input
                                class="custom-input"
                                type="number"
                                id="rightMargin"
                                value="10"
                                min="0"
                                max="45"
                            >
                        </div>

                        <div class="custom-field">
                            <span>Bottom %</span>
                            <input
                                class="custom-input"
                                type="number"
                                id="bottomMargin"
                                value="10"
                                min="0"
                                max="45"
                            >
                        </div>

