    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>

    <script>

        const pdfInput = document.getElementById("pdfInput");
        const fileInfo = document.getElementById("fileInfo");
        const fileName = document.getElementById("fileName");
        const fileSize = document.getElementById("fileSize");

        const cropPreset = document.getElementById("cropPreset");
        const customFields = document.getElementById("customFields");

        const topMargin = document.getElementById("topMargin");
        const rightMargin = document.getElementById("rightMargin");
        const bottomMargin = document.getElementById("bottomMargin");
        const leftMargin = document.getElementById("leftMargin");

        const cropBtn = document.getElementById("cropBtn");
        const result = document.getElementById("result");
        const resultText = document.getElementById("resultText");
        const downloadBtn = document.getElementById("downloadBtn");

        const errorMessage = document.getElementById("errorMessage");
        const progressMessage = document.getElementById("progressMessage");

        let selectedFile = null;
        let downloadUrl = null;


        function formatBytes(bytes) {

            if (bytes === 0) {
                return "0 Bytes";
            }

            const units = [
                "Bytes",
                "KB",
                "MB",
                "GB"
            ];

            const i = Math.floor(
                Math.log(bytes) / Math.log(1024)
            );

            return (
                parseFloat(
                    (bytes / Math.pow(1024, i)).toFixed(2)
                ) +
                " " +
                units[i]
            );
        }


        function showError(message) {

            errorMessage.textContent = message;
            errorMessage.style.display = "block";
        }


        function hideError() {

            errorMessage.style.display = "none";
            errorMessage.textContent = "";
        }


        function getMargins() {

            if (cropPreset.value !== "custom") {

                const value = Number(cropPreset.value);

                return {
                    top: value,
                    right: value,
                    bottom: value,
                    left: value
                };
            }

            return {
                top: Number(topMargin.value) || 0,
                right: Number(rightMargin.value) || 0,
                bottom: Number(bottomMargin.value) || 0,
                left: Number(leftMargin.value) || 0
            };
        }


        cropPreset.addEventListener("change", () => {

            if (cropPreset.value === "custom") {
                customFields.style.display = "grid";
            } else {
                customFields.style.display = "none";
            }

        });


        pdfInput.addEventListener("change", () => {

            hideError();

            result.style.display = "none";

            selectedFile = pdfInput.files[0];

            if (!selectedFile) {

                cropBtn.disabled = true;
                fileInfo.style.display = "none";

                return;
            }

            if (
                selectedFile.type !== "application/pdf" &&
                !selectedFile.name.toLowerCase().endsWith(".pdf")
            ) {

                showError("Please select a valid PDF file.");

                cropBtn.disabled = true;
                fileInfo.style.display = "none";

                return;
            }

            fileName.textContent = selectedFile.name;

            fileSize.textContent =
                formatBytes(selectedFile.size);

            fileInfo.style.display = "block";

            cropBtn.disabled = false;

        });


        cropBtn.addEventListener("click", async () => {

            if (!selectedFile) {
                showError("Please select a PDF file first.");
                return;
            }

            hideError();

            result.style.display = "none";

            cropBtn.disabled = true;

            progressMessage.style.display = "block";
            progressMessage.textContent = "Cropping PDF...";

            try {

                if (
                    typeof PDFLib === "undefined" ||
                    !PDFLib.PDFDocument
                ) {
                    throw new Error(
                        "PDF library failed to load. Please refresh the page and try again."
                    );
                }


                const margins = getMargins();


                const values = [
                    margins.top,
                    margins.right,
                    margins.bottom,
                    margins.left
                ];


                for (const value of values) {

                    if (
                        !Number.isFinite(value) ||
                        value < 0 ||
                        value > 45
                    ) {
                        throw new Error(
                            "Margins must be between 0% and 45%."
                        );
                    }
                }


                if (
                    margins.top + margins.bottom >= 100 ||
                    margins.left + margins.right >= 100
                ) {
                    throw new Error(
                        "The selected margins are too large."
                    );
                }


                const inputBytes =
                    await selectedFile.arrayBuffer();


                const pdfDoc =
                    await PDFLib.PDFDocument.load(inputBytes);


                const pages =
                    pdfDoc.getPages();


                for (const page of pages) {

                    const width = page.getWidth();
                    const height = page.getHeight();


                    const cropLeft =
                        width * (margins.left / 100);

                    const cropRight =
                        width * (margins.right / 100);

                    const cropTop =
                        height * (margins.top / 100);

                    const cropBottom =
                        height * (margins.bottom / 100);


                    const newWidth =
                        width - cropLeft - cropRight;

                    const newHeight =
                        height - cropTop - cropBottom;


                    if (
                        newWidth <= 1 ||
                        newHeight <= 1
                    ) {
                        throw new Error(
                            "Crop area is too small."
                        );
                    }


                    /*
                     * PDF coordinates start from
                     * the bottom-left corner.
                     *
                     * CropBox defines the visible
                     * portion of the page.
                     */

                    page.setCropBox(
                        cropLeft,
                        cropBottom,
                        newWidth,
                        newHeight
                    );

                }


                const outputBytes =
                    await pdfDoc.save();


                const blob =
                    new Blob(
                        [outputBytes],
                        {
                            type: "application/pdf"
                        }
                    );


                if (downloadUrl) {
                    URL.revokeObjectURL(downloadUrl);
                }


                downloadUrl =
                    URL.createObjectURL(blob);


                downloadBtn.href =
                    downloadUrl;


                resultText.textContent =
                    `${pages.length} page${pages.length === 1 ? "" : "s"} cropped successfully.`;


                result.style.display = "block";


            } catch (error) {

                console.error(error);

                showError(
                    error.message ||
                    "PDF cropping failed. Please try again."
                );

            } finally {

                cropBtn.disabled = false;
                progressMessage.style.display = "none";

            }

        });

    </script>

</body>
</html>
