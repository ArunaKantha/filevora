<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="Compress PDF files online for free with FileVora."
    >

    <title>PDF Compressor — FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>

    <style>
        #compressActions {
            display: none;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            width: 100%;
            margin-top: 16px;
        }

        #compressActions #compressBtn,
        #compressActions #resetBtn {
            width: 100% !important;
            height: 50px !important;
            min-height: 50px !important;
            margin: 0 !important;
            padding: 0 20px !important;
            box-sizing: border-box !important;
        }

        #compressActions #resetBtn {
            background: #ffffff !important;
            color: #00bc8a !important;
            border: 1px solid #00bc8a !important;
            box-shadow: none !important;
        }

        #compressActions #resetBtn:hover {
            background: #ecfdf8 !important;
            color: #00bc8a !important;
        }

        /* Keep Compress button visible while processing */
        #compressActions #compressBtn:disabled {
            display: flex !important;
        }
    </style>
</head>

<body class="pdf-tool">

<%- include("partials/tool-header") %>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    PDF
                </div>

                <h1>PDF Compressor</h1>

                <p>
                    Reduce PDF file size quickly while keeping your document usable.
                </p>

            </div>


            <label class="upload-area" for="pdfInput">

                <div class="upload-icon">↑</div>

                <strong>Choose a PDF file</strong>

                <span>PDF files only</span>

            </label>


            <input
                id="pdfInput"
                type="file"
                accept="application/pdf,.pdf"
            >


            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <div id="compressActions">

                <button
                    type="button"
                    class="convert-btn"
                    id="compressBtn"
                    disabled
                >
                    Compress PDF
                </button>

                <button
                    type="button"
                    class="convert-btn reset-btn"
                    id="resetBtn"
                >
                    Reset
                </button>

            </div>


            <div class="result" id="result">

                <h2>Compression Complete</h2>

                <p id="resultText"></p>

                <a
                    class="download-btn"
                    id="downloadBtn"
                    href="#"
                    download
                >
                    Download Compressed PDF
                </a>

            </div>

        </div>

    </div>

</main>


<footer class="site-footer">

    <div class="container footer-grid">

        <div class="footer-brand">

            <a class="brand" href="/">
                <span class="brand-mark">F</span>
                <span class="brand-name">
                    File<span>Vora</span>
                </span>
            </a>

            <p>
                Fast, simple online tools for everyday file tasks.
            </p>

        </div>

        <div>
            <h3>Company</h3>
            <a href="/about">About Us</a>
            <a href="/contact">Contact Us</a>
            <a href="/security">Security</a>
        </div>

        <div>
            <h3>Resources</h3>
            <a href="/blog">Blog</a>
            <a href="/#tools">Tools</a>
            <a href="/faq">FAQ</a>
        </div>

        <div>
            <h3>Legal</h3>
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/disclaimer">Disclaimer</a>
        </div>

        <div>
            <h3>Contact</h3>
            <a href="/contact">Email</a>
            <a href="/contact">Facebook</a>
            <a href="/contact">Instagram</a>
        </div>

    </div>

    <div class="container footer-bottom">
        <span>
            © <span data-current-year></span> FileVora. All rights reserved.
        </span>

        <span>All in One Tool.</span>
    </div>

</footer>


<script>
document
    .querySelectorAll("[data-current-year]")
    .forEach(function (element) {
        element.textContent =
            new Date().getFullYear();
    });
</script>


<script>

const pdfInput =
    document.getElementById("pdfInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const compressBtn =
    document.getElementById("compressBtn");

const resetBtn =
    document.getElementById("resetBtn");

const compressActions =
    document.getElementById("compressActions");

const result =
    document.getElementById("result");

const resultText =
    document.getElementById("resultText");

const downloadBtn =
    document.getElementById("downloadBtn");


let selectedFile = null;
let downloadUrl = null;


function formatSize(bytes) {

    if (bytes < 1024) {
        return bytes + " B";
    }

    if (bytes < 1024 * 1024) {
        return (bytes / 1024).toFixed(2) + " KB";
    }

    return (
        bytes / (1024 * 1024)
    ).toFixed(2) + " MB";
}


pdfInput.addEventListener("change", function () {

    const file =
        pdfInput.files[0];


    if (!file) {

        selectedFile = null;

        compressBtn.disabled = true;

        fileInfo.style.display = "none";
        result.style.display = "none";
        compressActions.style.display = "none";

        return;
    }


    if (file.type !== "application/pdf") {

        alert("Please choose a PDF file.");

        pdfInput.value = "";

        selectedFile = null;

        compressBtn.disabled = true;

        fileInfo.style.display = "none";
        result.style.display = "none";
        compressActions.style.display = "none";

        return;
    }


    selectedFile = file;


    fileName.textContent =
        file.name;


    fileSize.textContent =
        formatSize(file.size);


    fileInfo.style.display =
        "block";


    result.style.display =
        "none";


    compressBtn.disabled =
        false;


    compressActions.style.display =
        "grid";
});


compressBtn.addEventListener(
    "click",
    async function () {

        if (!selectedFile) {
            return;
        }


        compressBtn.disabled =
            true;

        compressBtn.textContent =
            "Compressing PDF...";


        result.style.display =
            "none";


        try {

            const originalBytes =
                await selectedFile.arrayBuffer();


            const pdf =
                await PDFLib.PDFDocument.load(
                    originalBytes
                );


            const compressedBytes =
                await pdf.save({
                    useObjectStreams: true,
                    addDefaultPage: false
                });


            const originalSize =
                selectedFile.size;


            const compressedSize =
                compressedBytes.length;


            const reduction =
                (
                    (originalSize - compressedSize) /
                    originalSize
                ) * 100;


            const blob =
                new Blob(
                    [compressedBytes],
                    {
                        type: "application/pdf"
                    }
                );


            if (downloadUrl) {
                URL.revokeObjectURL(downloadUrl);
            }


            downloadUrl =
                URL.createObjectURL(blob);


            downloadBtn.href =
                downloadUrl;


            downloadBtn.download =
                "filevora-compressed.pdf";


            if (
                compressedSize <
                originalSize
            ) {

                resultText.textContent =
                    `Original: ${formatSize(originalSize)} • Compressed: ${formatSize(compressedSize)} • Reduced by ${reduction.toFixed(1)}%.`;

            } else {

                resultText.textContent =
                    `Original: ${formatSize(originalSize)} • Optimized file: ${formatSize(compressedSize)}. This PDF was already highly optimized.`;
            }


            result.style.display =
                "block";


        } catch (error) {

            console.error(error);

            alert(
                "Something went wrong while compressing the PDF."
            );
        }


        compressBtn.disabled =
            false;


        compressBtn.textContent =
            "Compress PDF";
    }
);


resetBtn.addEventListener(
    "click",
    function () {

        pdfInput.value = "";

        selectedFile = null;


        fileName.textContent = "";
        fileSize.textContent = "";


        fileInfo.style.display =
            "none";


        result.style.display =
            "none";


        compressActions.style.display =
            "none";


        compressBtn.disabled =
            true;


        compressBtn.textContent =
            "Compress PDF";


        resultText.textContent = "";


        downloadBtn.href = "#";


        if (downloadUrl) {

            URL.revokeObjectURL(
                downloadUrl
            );

            downloadUrl = null;
        }
    }
);

</script>


<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>