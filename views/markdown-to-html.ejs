<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Markdown to HTML Converter - FileVora</title>
    <meta name="description" content="Convert Markdown text to clean HTML instantly with FileVora.">

    <link rel="stylesheet" href="/css/style.css">

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

<style>
/* FileVora Text Tools batch standardization */
.text-tool .converter-card textarea,
.text-tool .converter-card input[type="text"],
.text-tool .converter-card input[type="number"],
.text-tool .converter-card select {
    border-color:#cbd5e1 !important;
}
.text-tool .converter-card textarea:focus,
.text-tool .converter-card input:focus,
.text-tool .converter-card select:focus {
    border-color:#ef1f2b !important;
    outline:none !important;
}
.text-tool .text-reset-btn {
    background:#ffffff !important;
    color:#ef1f2b !important;
    border:1px solid #ef1f2b !important;
    box-shadow:none !important;
}
.text-tool .text-reset-btn:hover {
    background:#fff5f5 !important;
}
.text-tool .text-action-row {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:18px;
}
.text-tool .text-action-row > .convert-btn,
.text-tool .text-action-row > .download-btn,
.text-tool .text-action-row > button,
.text-tool .text-action-row > a {
    margin-top:0 !important;
    width:100% !important;
    box-sizing:border-box !important;
}
@media (max-width:600px){
    .text-tool .text-action-row{grid-template-columns:1fr;}
}
</style>
</head>

<body class="text-tool">
<%- include("partials/tool-header") %>

<main class="converter-page">
        <div class="container">

            <div class="converter-card">

                <div class="converter-header">

                    <div class="tool-icon">MD</div>

                    <h1>Markdown to HTML Converter</h1>

                    <p>
                        Convert Markdown text into clean HTML instantly.
                    </p>

                </div>

                <textarea
                    id="markdownInput"
                    placeholder="# Hello World

Write your **Markdown** here...

- Item 1
- Item 2
- Item 3"
                    style="
                        width:100%;
                        min-height:260px;
                        padding:16px;
                        border:1px solid #cbd5e1;
                        border-radius:12px;
                        resize:vertical;
                        font-family:monospace;
                        font-size:14px;
                        box-sizing:border-box;
                        outline:none;
                    "
                ></textarea>

                <div class="text-action-row">
<button
                    class="convert-btn"
                    id="convertBtn"
                >
                    Convert to HTML
                </button>
<button type="button" class="convert-btn text-reset-btn" id="resetBtn">Reset</button>
</div>

                <div
                    class="result"
                    id="result"
                    style="text-align:left;"
                >

                    <h2>HTML Generated</h2>

                    <textarea
                        id="htmlOutput"
                        readonly
                        style="
                            width:100%;
                            min-height:220px;
                            margin-top:14px;
                            padding:14px;
                            border:1px solid #d1d5db;
                            border-radius:10px;
                            background:#ffffff;
                            font-family:monospace;
                            font-size:13px;
                            line-height:1.5;
                            box-sizing:border-box;
                            resize:vertical;
                        "
                    ></textarea>

                    <button
                        class="download-btn"
                        id="copyBtn"
                        type="button"
                    >
                        Copy HTML
                    </button>

                    <a
                        href="#"
                        class="download-btn"
                        id="downloadBtn"
                        style="margin-left:8px;"
                    >
                        Download HTML
                    </a>

                </div>

            </div>

        </div>
    </main>

    <script>

        const markdownInput =
            document.getElementById("markdownInput");

        const convertBtn =
            document.getElementById("convertBtn");

        const result =
            document.getElementById("result");

        const htmlOutput =
            document.getElementById("htmlOutput");

        const copyBtn =
            document.getElementById("copyBtn");

        const downloadBtn =
            document.getElementById("downloadBtn");

        const resetBtn =
            document.getElementById("resetBtn");


        convertBtn.addEventListener("click", function () {

            const markdown = markdownInput.value.trim();

            if (!markdown) {
                alert("Please enter some Markdown text.");
                return;
            }

            const html = marked.parse(markdown);

            htmlOutput.value = html;

            const blob = new Blob(
                [html],
                {
                    type: "text/html;charset=utf-8"
                }
            );

            const url = URL.createObjectURL(blob);

            downloadBtn.href = url;
            downloadBtn.download = "converted.html";

            result.style.display = "block";

        });


        copyBtn.addEventListener("click", async function () {

            if (!htmlOutput.value) {
                return;
            }

            try {

                await navigator.clipboard.writeText(
                    htmlOutput.value
                );

                copyBtn.textContent = "Copied";

                setTimeout(() => {
                    copyBtn.textContent = "Copy HTML";
                }, 1500);

            } catch (error) {

                htmlOutput.select();
                document.execCommand("copy");

                copyBtn.textContent = "Copied";

                setTimeout(() => {
                    copyBtn.textContent = "Copy HTML";
                }, 1500);

            }

        });


        resetBtn.addEventListener("click", function () {
            markdownInput.value = "";
            htmlOutput.value = "";
            result.style.display = "none";
            downloadBtn.href = "#";
            markdownInput.focus();
        });

    </script>

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a class="brand" href="/"><span class="brand-mark">F</span><span class="brand-name">File<span>Vora</span></span></a><p>Fast, simple online tools for everyday file tasks.</p></div>
    <div><h3>Company</h3><a href="/about">About Us</a><a href="/contact">Contact Us</a><a href="/security">Security</a></div>
    <div><h3>Resources</h3><a href="/blog">Blog</a><a href="/#tools">Tools</a><a href="/faq">FAQ</a></div>
    <div><h3>Legal</h3><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a><a href="/disclaimer">Disclaimer</a></div>
    <div><h3>Contact</h3><a href="/contact">Email</a><a href="/contact">Facebook</a><a href="/contact">Instagram</a></div>
  </div>
  <div class="container footer-bottom"><span>© <span data-current-year></span> FileVora. All rights reserved.</span><span>All in One Tool.</span></div>
</footer>
<script>document.querySelectorAll('[data-current-year]').forEach(el=>el.textContent=new Date().getFullYear());</script>

<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>

