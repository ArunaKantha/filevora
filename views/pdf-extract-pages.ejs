<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Extract PDF Pages - FileVora</title>

    <meta
        name="description"
        content="Extract selected pages from a PDF and create a new PDF with FileVora."
    >

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .page-input-area {
            margin-top: 22px;
            text-align: left;
        }

        .page-input-area label {
            display: block;
            margin-bottom: 8px;
