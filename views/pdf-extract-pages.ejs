    </style>
</head>

<body>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">📑</div>

                <h1>Extract PDF Pages</h1>

                <p>
                    Select specific pages from a PDF and create a new PDF.
                </p>

            </div>


            <label class="upload-area" for="pdfInput">

                <div class="upload-icon">📄</div>

                <strong>Click to upload PDF</strong>

                <span>Choose one PDF file</span>

            </label>


            <input
                type="file"
                id="pdfInput"
                accept="application/pdf,.pdf"
                style="display:none;"
            >


            <div
                class="file-info"
                id="fileInfo"
            >

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <div class="page-input-area">

                <label for="pageInput">
                    Pages to Extract
                </label>

                <input
                    type="text"
                    id="pageInput"
                    class="page-input"
                    placeholder="Example: 1,3,5-8"
                    autocomplete="off"
                >

                <div class="page-help">
                    Enter page numbers or ranges.
                    Example:
                    <strong>1,3,5-8</strong>
                    extracts pages 1, 3, 5, 6, 7 and 8.
                    Leave blank to extract all pages.
                </div>

                <div
                    class="page-count"
                    id="pageCount"
                ></div>

            </div>


            <button
                class="convert-btn"
                id="extractBtn"
                disabled
            >
                Extract Pages
            </button>


            <div
                class="progress-message"
                id="progressMessage"
            >
                Extracting pages...
            </div>


            <div
                class="error-message"
                id="errorMessage"
            ></div>


            <div
                class="result"
                id="result"
            >

                <h2>
                    Pages Extracted Successfully
                </h2>

                <p id="resultText">
                    Your new PDF is ready.
                </p>

                <a
                    class="download-btn"
                    id="downloadBtn"
                    href="#"
                    download="filevora-extracted-pages.pdf"
                >
                    ⬇ Download Extracted PDF
                </a>

            </div>

        </div>

    </div>

</main>


<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>


<script>

    const pdfInput =
        document.getElementById("pdfInput");

    const fileInfo =
        document.getElementById("fileInfo");

    const fileName =
        document.getElementById("fileName");

    const fileSize =
        document.getElementById("fileSize");

    const pageInput =
        document.getElementById("pageInput");

    const pageCount =
        document.getElementById("pageCount");

    const extractBtn =
        document.getElementById("extractBtn");

    const progressMessage =
        document.getElementById("progressMessage");

    const errorMessage =
        document.getElementById("errorMessage");

    const result =
        document.getElementById("result");

    const resultText =
        document.getElementById("resultText");

    const downloadBtn =
        document.getElementById("downloadBtn");


    let selectedFile = null;

    let downloadUrl = null;

    let totalPages = 0;


    function formatBytes(bytes) {

        if (bytes === 0) {
            return "0 Bytes";
        }

        const units = [
            "Bytes",
            "KB",
            "MB",
            "GB"
        ];

        const index =
            Math.floor(
                Math.log(bytes) /
                Math.log(1024)
            );

        return (
            parseFloat(
                (
                    bytes /
                    Math.pow(1024, index)
                ).toFixed(2)
            ) +
            " " +
            units[index]
        );
    }


    function showError(message) {

        errorMessage.textContent =
            message;

        errorMessage.style.display =
            "block";
    }


    function hideError() {

        errorMessage.textContent = "";

        errorMessage.style.display =
            "none";
    }


    /*
     * Convert input such as:
     *
     * 1,3,5-8
     *
     * into zero-based page indexes.
     */

    function parsePageSelection(
        input,
        maxPages
    ) {

        if (!input.trim()) {

            return Array.from(
                {
                    length: maxPages
                },
                (_, index) => index
            );
        }


        const parts =
            input
                .split(",")
                .map(part => part.trim())
                .filter(Boolean);


        if (parts.length === 0) {

            throw new Error(
                "Please enter valid page numbers."
            );
        }


        const pages = [];


        for (const part of parts) {

            /*
             * Single page
             */

            if (/^\d+$/.test(part)) {

                const page =
                    Number(part);


                if (
                    page < 1 ||
                    page > maxPages
                ) {

                    throw new Error(
                        `Page ${page} does not exist. This PDF has ${maxPages} pages.`
                    );
                }


                pages.push(page - 1);

                continue;
            }


            /*
             * Page range
             *
             * Example:
             * 5-8
             */

            const rangeMatch =
                part.match(
                    /^(\d+)\s*-\s*(\d+)$/
                );


            if (rangeMatch) {

                const start =
                    Number(rangeMatch[1]);

                const end =
                    Number(rangeMatch[2]);


                if (
                    start < 1 ||
                    end < 1 ||
                    start > maxPages ||
                    end > maxPages
                ) {

                    throw new Error(
                        `Page range ${part} is outside the PDF page range.`
                    );
                }


                if (start > end) {

                    throw new Error(
                        `Invalid page range: ${part}`
                    );
                }


                for (
                    let page = start;
                    page <= end;
                    page++
                ) {

                    pages.push(page - 1);
                }


                continue;
            }


            throw new Error(
                `Invalid page selection: "${part}"`
            );
        }


        /*
         * Remove duplicates while preserving
         * the order entered by the user.
         */

        return [
            ...new Set(pages)
        ];
    }


    pdfInput.addEventListener(
        "change",
        async () => {

            hideError();

            result.style.display =
                "none";

            pageCount.style.display =
                "none";

            selectedFile =
                pdfInput.files[0];


            if (!selectedFile) {

                extractBtn.disabled =
                    true;

                fileInfo.style.display =
                    "none";

                return;
            }


            if (
                selectedFile.type !==
                    "application/pdf" &&
                !selectedFile.name
                    .toLowerCase()
                    .endsWith(".pdf")
            ) {

                showError(
                    "Please select a valid PDF file."
                );

                extractBtn.disabled =
                    true;

                fileInfo.style.display =
                    "none";

                return;
            }


            fileName.textContent =
                selectedFile.name;

            fileSize.textContent =
                formatBytes(
                    selectedFile.size
                );

            fileInfo.style.display =
                "block";


            try {

                const bytes =
                    await selectedFile.arrayBuffer();


                const pdfDoc =
                    await PDFLib.PDFDocument.load(
                        bytes
                    );


                totalPages =
                    pdfDoc.getPageCount();


                pageCount.textContent =
                    `This PDF contains ${totalPages} page${totalPages === 1 ? "" : "s"}.`;


                pageCount.style.display =
                    "block";


                extractBtn.disabled =
                    false;


            } catch (error) {

                console.error(error);

                showError(
                    "Could not read this PDF. Please choose another file."
                );

                extractBtn.disabled =
                    true;
            }

        }
    );


    pageInput.addEventListener(
        "input",
        () => {

            hideError();

            result.style.display =
                "none";
        }
    );


    extractBtn.addEventListener(
        "click",
        async () => {

            if (!selectedFile) {

                showError(
                    "Please select a PDF file first."
                );

                return;
            }


            hideError();

            result.style.display =
                "none";

            extractBtn.disabled =
                true;

            progressMessage.style.display =
                "block";


            try {

                if (
                    typeof PDFLib ===
                        "undefined" ||
                    !PDFLib.PDFDocument
                ) {

                    throw new Error(
                        "PDF library failed to load. Please refresh the page and try again."
                    );
                }


                const inputBytes =
                    await selectedFile.arrayBuffer();


                const sourcePdf =
                    await PDFLib.PDFDocument.load(
                        inputBytes
                    );


                totalPages =
                    sourcePdf.getPageCount();


                const selectedPages =
                    parsePageSelection(
                        pageInput.value,
                        totalPages
                    );


                if (
                    selectedPages.length === 0
                ) {

                    throw new Error(
                        "Please select at least one page."
                    );
                }


                progressMessage.textContent =
                    "Preparing extracted PDF...";


                const outputPdf =
                    await PDFLib.PDFDocument.create();


                const copiedPages =
                    await outputPdf.copyPages(
                        sourcePdf,
                        selectedPages
                    );


                for (
                    let i = 0;
                    i < copiedPages.length;
                    i++
                ) {

                    outputPdf.addPage(
                        copiedPages[i]
                    );


                    progressMessage.textContent =
                        `Extracting page ${i + 1} of ${copiedPages.length}...`;
                }


                const outputBytes =
                    await outputPdf.save();


                const blob =
                    new Blob(
                        [outputBytes],
                        {
                            type:
                                "application/pdf"
                        }
                    );


                if (downloadUrl) {

                    URL.revokeObjectURL(
                        downloadUrl
                    );
                }


                downloadUrl =
                    URL.createObjectURL(blob);


                downloadBtn.href =
                    downloadUrl;


                resultText.textContent =
                    `${selectedPages.length} page${selectedPages.length === 1 ? "" : "s"} extracted successfully.`;


                result.style.display =
                    "block";


            } catch (error) {

                console.error(error);

                showError(
                    error.message ||
                    "Page extraction failed. Please try again."
                );

            } finally {

                extractBtn.disabled =
                    false;

                progressMessage.style.display =
                    "none";
            }

        }
    );

</script>

</body>
</html>
