<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PNG to JPG Converter - FILEVORA</title>

    <meta
        name="description"
        content="Convert PNG images to JPG online for free with FILEVORA."
    >

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .tool-page {
            padding: 70px 0;
        }

        .tool-page h1 {
            text-align: center;
            font-size: 40px;
            margin-bottom: 10px;
        }

        .tool-intro {
            text-align: center;
            color: #6b7280;
            margin-bottom: 35px;
        }

        .converter-box {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 35px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
        }

        .upload-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 180px;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            cursor: pointer;
            text-align: center;
        }

        .upload-area:hover {
            border-color: #2563eb;
            background: #f8faff;
        }

        .upload-icon {
            font-size: 45px;
            margin-bottom: 10px;
        }

        .upload-area strong {
            font-size: 18px;
        }

        .upload-area small {
            color: #6b7280;
            margin-top: 5px;
        }

        .upload-area input {
            display: none;
        }

        .preview-area {
            margin-top: 30px;
            text-align: center;
        }

        .preview-area img {
            max-width: 100%;
            max-height: 400px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
        }

        .file-info {
            margin: 20px 0;
            color: #4b5563;
        }

        .convert-btn {
            width: 100%;
            border: none;
            padding: 14px;
            background: #2563eb;
            color: white;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
        }

        .convert-btn:hover {
            background: #1d4ed8;
        }

        .result-area {
            margin-top: 30px;
            padding: 25px;
            background: #f8fafc;
            border-radius: 10px;
            text-align: center;
        }

        .download-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 12px 25px;
            background: #16a34a;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 700;
        }

        .download-btn:hover {
            background: #15803d;
        }

        @media (max-width: 600px) {
            .converter-box {
                padding: 20px;
            }

            .tool-page h1 {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="container nav">

        <a href="/" class="logo">FILEVORA</a>

        <nav>
            <a href="/">Home</a>
            <a href="/#tools">Tools</a>
            <a href="/#categories">Categories</a>
        </nav>

    </div>
</header>

<main>

    <section class="tool-page">

        <div class="container">

            <h1>PNG to JPG Converter</h1>

            <p class="tool-intro">
                Convert PNG images to JPG format online for free.
            </p>

            <div class="converter-box">

                <label for="imageInput" class="upload-area">

                    <span class="upload-icon">🖼️</span>

                    <strong>Choose a PNG image</strong>

                    <small>
                        PNG files only
                    </small>

                    <input
                        type="file"
                        id="imageInput"
                        accept="image/png"
                    >

                </label>

                <div id="previewArea" class="preview-area" hidden>

                    <img
                        id="previewImage"
                        alt="PNG image preview"
                    >

                    <div class="file-info">

                        <p>
                            File:
                            <strong id="fileName">-</strong>
                        </p>

                        <p>
                            Original size:
                            <strong id="fileSize">-</strong>
                        </p>

                    </div>

                    <button
                        type="button"
                        id="convertBtn"
                        class="convert-btn"
                    >
                        Convert to JPG
                    </button>

                    <div
                        id="resultArea"
                        class="result-area"
                        hidden
                    >

                        <h2>Conversion Complete</h2>

                        <p>
                            Your PNG image has been converted to JPG.
                        </p>

                        <a
                            id="downloadBtn"
                            class="download-btn"
                            download="filevora-converted.jpg"
                        >
                            Download JPG
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<footer class="footer">

    <div class="container">

        <p>
            © 2026 FILEVORA. All rights reserved.
        </p>

    </div>

</footer>

<script src="/js/png-to-jpg.js"></script>

</body>
</html>