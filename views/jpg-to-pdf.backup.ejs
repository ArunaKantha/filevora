/* =====================================================
   NORMALIZE SEARCH
===================================================== */

function normalizeToolSearch(value) {

    return value
        .toLowerCase()
        .replace(/→|⇒|➜|➡|->/g, " to ")
        .replace(/[\/\\|_–—-]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
}


/* =====================================================
   HEADER ELEMENTS
===================================================== */

const globalToolsBtn =
    document.getElementById("globalToolsBtn");

const globalCategoriesBtn =
    document.getElementById("globalCategoriesBtn");

const globalToolPanel =
    document.getElementById("globalToolPanel");

const globalCategoryPanel =
    document.getElementById("globalCategoryPanel");

const globalToolSearch =
    document.getElementById("globalToolSearch");

const globalToolResults =
    document.getElementById("globalToolResults");

const categoryToolsBox =
    document.getElementById("categoryToolsBox");

const categoryToolsTitle =
    document.getElementById("categoryToolsTitle");

const categoryToolsGrid =
    document.getElementById("categoryToolsGrid");


/* =====================================================
   RENDER TOOL SEARCH
===================================================== */

function renderToolSearch() {

    const query =
        normalizeToolSearch(
            globalToolSearch.value
        );

    const words =
        query
            .split(" ")
            .filter(Boolean);


    let tools =
        fileVoraTools;


    if (words.length) {

        tools =
            fileVoraTools.filter(
                function(tool) {

                    const searchable =
                        normalizeToolSearch(
                            tool.name +
                            " " +
                            tool.category +
                            " " +
                            tool.url
                        );


                    return words.every(
                        function(word) {
                            return searchable.includes(
                                word
                            );
                        }
                    );
                }
            );

    } else {

        tools =
            fileVoraTools.slice(0, 18);
    }


    globalToolResults.innerHTML =
        "";


    if (!tools.length) {

        globalToolResults.innerHTML =
            '<div class="global-empty">No tools found.</div>';

        return;
    }


    tools.forEach(
        function(tool) {

            const link =
                document.createElement(
                    "a"
                );


            link.href =
                tool.url;


            link.className =
                "global-tool-item";


            link.innerHTML =
                tool.name +
                "<small>" +
                tool.category +
                "</small>";


            globalToolResults.appendChild(
                link
            );
        }
    );
}


/* =====================================================
   TOOLS BUTTON
===================================================== */

globalToolsBtn.addEventListener(
    "click",
    function() {

        const opening =
            !globalToolPanel.classList.contains(
                "show"
            );


        globalCategoryPanel.classList.remove(
            "show"
        );


        categoryToolsBox.classList.remove(
            "show"
        );


        globalToolPanel.classList.toggle(
            "show",
            opening
        );


        if (opening) {

            renderToolSearch();


            setTimeout(
                function() {
                    globalToolSearch.focus();
                },
                100
            );
        }

    }
);


globalToolSearch.addEventListener(
    "input",
    renderToolSearch
);


/* =====================================================
   CATEGORIES BUTTON
===================================================== */

globalCategoriesBtn.addEventListener(
    "click",
    function() {

        const opening =
            !globalCategoryPanel.classList.contains(
                "show"
            );


        globalToolPanel.classList.remove(
            "show"
        );


        globalCategoryPanel.classList.toggle(
            "show",
            opening
        );


        if (!opening) {

            categoryToolsBox.classList.remove(
                "show"
            );
        }

    }
);


