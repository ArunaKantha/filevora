                "click",
                function() {

                    const category =
                        button.dataset.category;


                    const tools =
                        fileVoraTools.filter(
                            function(tool) {

                                return tool.category ===
                                    category;
                            }
                        );


                    categoryToolsTitle.textContent =
                        category;


                    categoryToolsGrid.innerHTML =
                        "";


                    if (!tools.length) {

                        categoryToolsGrid.innerHTML =
                            '<div class="global-empty">No tools available yet.</div>';

                    } else {

                        tools.forEach(
                            function(tool) {

                                const link =
                                    document.createElement(
                                        "a"
                                    );


                                link.href =
                                    tool.url;


                                link.className =
                                    "global-tool-item";


                                link.textContent =
                                    tool.name;


                                categoryToolsGrid.appendChild(
                                    link
                                );
                            }
                        );
                    }


                    categoryToolsBox.classList.add(
                        "show"
                    );

                }
            );
        }
    );


/* =====================================================
   ESC CLOSE
===================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Escape") {

            globalToolPanel.classList.remove(
                "show"
            );


            globalCategoryPanel.classList.remove(
                "show"
            );


            categoryToolsBox.classList.remove(
                "show"
            );
        }

    }
);

</script>


<script>
/* =====================================================
   JPG TO PDF
===================================================== */

const imageInput =
    document.getElementById("imageInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const convertBtn =
    document.getElementById("convertBtn");

const jpgPdfActions =
    document.getElementById("jpgPdfActions");

const resetBtn =
    document.getElementById("resetBtn");

const result =
    document.getElementById("result");

const downloadBtn =
    document.getElementById("downloadBtn");

let pdfDownloadUrl =
    "";


/* =========================
   FILE SELECT
========================= */

imageInput.addEventListener(
    "change",
    function() {

        const file =
            imageInput.files[0];


        if (!file) {

            resetJpgPdf();

            return;
        }


        if (
            file.type !== "image/jpeg"
        ) {

            alert(
                "Please choose a JPG or JPEG image."
            );


            imageInput.value =
                "";


            return;
        }


        fileName.textContent =
            file.name;


        const sizeMB =
            file.size /
            (1024 * 1024);


        fileSize.textContent =
            sizeMB >= 1
                ? sizeMB.toFixed(2) + " MB"
                : (file.size / 1024).toFixed(2) + " KB";


        fileInfo.style.display =
            "block";


        jpgPdfActions.hidden =
            false;


        convertBtn.disabled =
            false;


        result.style.display =
            "none";

    }
);


/* =========================
   CONVERT
========================= */

convertBtn.addEventListener(
    "click",
    function() {

        const file =
            imageInput.files[0];


        if (!file) {

            return;
        }


        convertBtn.disabled =
            true;


        convertBtn.textContent =
            "Creating PDF...";


        const reader =
            new FileReader();


        reader.onload =
            function(event) {

                const image =
                    new Image();


                image.onload =
                    function() {

                        try {

                            const {
                                jsPDF
                            } =
                                window.jspdf;


                            const pdf =
                                new jsPDF({
                                    orientation:"portrait",
                                    unit:"mm",
                                    format:"a4"
                                });


                            const pageWidth =
                                210;

                            const pageHeight =
                                297;

                            const margin =
                                10;


                            const maxWidth =
                                pageWidth -
                                (margin * 2);


                            const maxHeight =
                                pageHeight -
                                (margin * 2);


                            const imageRatio =
                                image.width /
                                image.height;


                            let imageWidth =
                                maxWidth;


                            let imageHeight =
                                imageWidth /
                                imageRatio;


                            if (
                                imageHeight >
                                maxHeight
                            ) {

                                imageHeight =
                                    maxHeight;


                                imageWidth =
                                    imageHeight *
                                    imageRatio;
                            }


                            const x =
                                (
                                    pageWidth -
                                    imageWidth
                                ) / 2;


                            const y =
                                (
                                    pageHeight -
                                    imageHeight
                                ) / 2;


                            pdf.addImage(
                                event.target.result,
                                "JPEG",
                                x,
                                y,
                                imageWidth,
                                imageHeight
                            );


                            const pdfBlob =
                                pdf.output(
                                    "blob"
                                );


                            if (
                                pdfDownloadUrl
                            ) {

                                URL.revokeObjectURL(
                                    pdfDownloadUrl
                                );
                            }


                            pdfDownloadUrl =
                                URL.createObjectURL(
                                    pdfBlob
                                );


                            downloadBtn.href =
                                pdfDownloadUrl;


                            downloadBtn.download =
                                "filevora-image.pdf";


                            result.style.display =
                                "block";


                            result.scrollIntoView({
                                behavior:"smooth",
                                block:"nearest"
                            });


                        } catch (error) {

                            console.error(
                                error
                            );


                            alert(
                                "Something went wrong while creating the PDF."
                            );

                        } finally {

                            convertBtn.disabled =
                                false;


                            convertBtn.textContent =
                                "Convert to PDF";
                        }

                    };


                image.onerror =
                    function() {

                        alert(
                            "Unable to read the JPG image."
                        );


                        convertBtn.disabled =
                            false;


                        convertBtn.textContent =
                            "Convert to PDF";
                    };


                image.src =
                    event.target.result;

            };


        reader.readAsDataURL(
            file
        );

    }
);


/* =========================
   RESET
========================= */

function resetJpgPdf() {

    imageInput.value =
        "";


    fileName.textContent =
        "";


    fileSize.textContent =
        "";


    fileInfo.style.display =
        "none";


    jpgPdfActions.hidden =
        true;


    convertBtn.disabled =
        false;


    convertBtn.textContent =
        "Convert to PDF";


    result.style.display =
        "none";


    downloadBtn.removeAttribute(
        "href"
    );


    if (
        pdfDownloadUrl
    ) {

        URL.revokeObjectURL(
            pdfDownloadUrl
        );


        pdfDownloadUrl =
            "";
    }

}


resetBtn.addEventListener(
    "click",
    resetJpgPdf
);

</script>

</body>
</html>