<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSON Minifier - FileVora</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="converter-page">
    <div class="container">
        <div class="converter-card">

            <div class="converter-header">
                <div class="tool-icon">🗜️</div>
                <h1>JSON Minifier</h1>
                <p>Minify JSON data instantly.</p>
            </div>

            <label for="jsonInput">JSON Code</label>

            <textarea
                id="jsonInput"
                placeholder="Paste your JSON here..."
                style="width:100%;min-height:260px;padding:15px;border:1px solid #ddd;border-radius:10px;font-family:monospace;font-size:14px;box-sizing:border-box;"
            ></textarea>

            <button
                type="button"
                class="convert-btn"
                onclick="minifyJSON()"
                style="margin-top:15px;"
            >
                Minify JSON
            </button>

            <div class="result" style="margin-top:25px;">

                <label for="output">Minified JSON</label>

                <textarea
                    id="output"
                    readonly
                    placeholder="Minified JSON will appear here..."
                    style="width:100%;min-height:220px;padding:15px;border:1px solid #ddd;border-radius:10px;font-family:monospace;font-size:14px;box-sizing:border-box;"
                ></textarea>

                <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:15px;">

                    <button
                        type="button"
                        class="download-btn"
                        onclick="copyJSON()"
                    >
                        Copy JSON
                    </button>

                    <button
                        type="button"
                        class="download-btn"
                        onclick="downloadJSON()"
                    >
                        Download JSON
                    </button>

                </div>

            </div>

        </div>
    </div>
</div>

<script>

function minifyJSON() {

    var input = document.getElementById("jsonInput");
    var output = document.getElementById("output");

    try {

        var data = JSON.parse(input.value);

        output.value = JSON.stringify(data);

    } catch (error) {

        alert("Invalid JSON. Please check your JSON code.");

    }
}


function copyJSON() {

    var output = document.getElementById("output");

    if (output.value.trim() === "") {
        alert("Please minify JSON first.");
        return;
    }

    output.select();
    document.execCommand("copy");

    alert("JSON copied successfully!");
}


function downloadJSON() {

    var output = document.getElementById("output");

    if (output.value.trim() === "") {
        alert("Please minify JSON first.");
        return;
    }

    var blob = new Blob(
        [output.value],
        { type: "application/json" }
    );

    var url = URL.createObjectURL(blob);

    var link = document.createElement("a");

    link.href = url;
    link.download = "filevora-minified.json";

    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    URL.revokeObjectURL(url);
}

</script>

</body>
</html>