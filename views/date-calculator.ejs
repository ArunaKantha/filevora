```ejs
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Date Calculator - FileVora</title>
    <meta name="description" content="Calculate the difference between dates and add or subtract days with FileVora Date Calculator.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main class="converter-page">
        <div class="container">

            <div class="converter-card">

                <div class="converter-header">
                    <div class="tool-icon">📅</div>

                    <h1>Date Calculator</h1>

                    <p>
                        Calculate date differences and add or subtract days easily.
                    </p>
                </div>

                <!-- Date Difference -->
                <div style="text-align:left;">

                    <h2 style="font-size:20px; color:#111827; margin:0 0 18px;">
                        Date Difference
                    </h2>

                    <div style="display:grid; gap:16px;">

                        <div>
                            <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                                Start Date
                            </label>

                            <input
                                type="date"
                                id="startDate"
                                style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                            >
                        </div>

                        <div>
                            <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                                End Date
                            </label>

                            <input
                                type="date"
                                id="endDate"
                                style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                            >
                        </div>

                    </div>

                    <button
                        type="button"
                        class="convert-btn"
                        id="differenceBtn"
                    >
                        Calculate Difference
                    </button>

                    <div
                        id="differenceResult"
                        class="result"
                    >
                        <h2>Result</h2>
                        <p id="differenceText"></p>
                    </div>

                </div>

                <hr style="margin:35px 0; border:0; border-top:1px solid #e5e7eb;">

                <!-- Add / Subtract -->
                <div style="text-align:left;">

                    <h2 style="font-size:20px; color:#111827; margin:0 0 18px;">
                        Add / Subtract Days
                    </h2>

                    <div style="display:grid; gap:16px;">

                        <div>
                            <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                                Starting Date
                            </label>

                            <input
                                type="date"
                                id="baseDate"
                                style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                            >
                        </div>

                        <div>
                            <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                                Number of Days
                            </label>

                            <input
                                type="number"
                                id="days"
                                placeholder="Enter number of days"
                                min="0"
                                step="1"
                                style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                            >
                        </div>

                        <div>
                            <label style="display:block; margin-bottom:7px; font-weight:700; color:#111827;">
                                Operation
                            </label>

                            <select
                                id="operation"
                                style="width:100%; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px; background:#fff;"
                            >
                                <option value="add">Add Days</option>
                                <option value="subtract">Subtract Days</option>
                            </select>
                        </div>

                    </div>

                    <button
                        type="button"
                        class="convert-btn"
                        id="calculateDateBtn"
                    >
                        Calculate Date
                    </button>

                    <div
                        id="dateResult"
                        class="result"
                    >
                        <h2>Result</h2>
                        <p id="dateText"></p>
                    </div>

                </div>

            </div>

        </div>
    </main>

    <script>

        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");

        const differenceBtn = document.getElementById("differenceBtn");
        const differenceResult = document.getElementById("differenceResult");
        const differenceText = document.getElementById("differenceText");

        const baseDate = document.getElementById("baseDate");
        const daysInput = document.getElementById("days");
        const operation = document.getElementById("operation");

        const calculateDateBtn = document.getElementById("calculateDateBtn");
        const dateResult = document.getElementById("dateResult");
        const dateText = document.getElementById("dateText");


        function parseDate(value) {

            const parts = value.split("-");

            return new Date(
                Number(parts[0]),
                Number(parts[1]) - 1,
                Number(parts[2])
            );

        }


        function formatDate(date) {

            return date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric"
            });

        }


        // Date Difference
        differenceBtn.addEventListener("click", () => {

            if (!startDate.value || !endDate.value) {

                alert("Please select both dates.");
                return;

            }

            let start = parseDate(startDate.value);
            let end = parseDate(endDate.value);

            // Make sure start is earlier
            if (start > end) {
                [start, end] = [end, start];
            }

            // Calculate Years, Months and Days
            let years =
                end.getFullYear() - start.getFullYear();

            let months =
                end.getMonth() - start.getMonth();

            let days =
                end.getDate() - start.getDate();


            // Borrow days from previous month
            if (days < 0) {

                months--;

                const previousMonth = new Date(
                    end.getFullYear(),
                    end.getMonth(),
                    0
                );

                days += previousMonth.getDate();

            }


            // Borrow months from previous year
            if (months < 0) {

                years--;
                months += 12;

            }


            // Total days
            const totalMilliseconds =
                end.getTime() - start.getTime();

            const totalDays =
                Math.round(
                    totalMilliseconds /
                    (1000 * 60 * 60 * 24)
                );


            // Total weeks
            const totalWeeks =
                Math.floor(totalDays / 7);

            const weekDays =
                totalDays % 7;


            differenceText.innerHTML = `
                <strong>${years}</strong> Years,
                <strong>${months}</strong> Months,
                <strong>${days}</strong> Days

                <br><br>

                Total:
                <strong>${totalDays.toLocaleString()}</strong> Days

                <br>

                <strong>${totalWeeks.toLocaleString()}</strong> Weeks,
                <strong>${weekDays}</strong> Days
            `;

            differenceResult.style.display = "block";

        });


        // Add / Subtract Days
        calculateDateBtn.addEventListener("click", () => {

            if (!baseDate.value) {

                alert("Please select a starting date.");
                return;

            }

            const days =
                parseInt(daysInput.value, 10);

            if (isNaN(days) || days < 0) {

                alert("Please enter a valid number of days.");
                return;

            }

            const date =
                parseDate(baseDate.value);


            if (operation.value === "add") {

                date.setDate(
                    date.getDate() + days
                );

            } else {

                date.setDate(
                    date.getDate() - days
                );

            }


            const operationText =
                operation.value === "add"
                    ? "after adding"
                    : "after subtracting";


            dateText.innerHTML = `
                The resulting date is:

                <br><br>

                <strong>${formatDate(date)}</strong>

                <br><br>

                ${days.toLocaleString()} days ${operationText}.
            `;

            dateResult.style.display = "block";

        });

    </script>

</body>
</html>
```
