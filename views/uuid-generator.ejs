<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>UUID Generator - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tool-unified.css">
<link rel="stylesheet" href="/css/filevora-header-tools.css">

    <style>
        .uuid-action-row{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:10px;
            margin-top:18px;
        }

        .uuid-action-row .convert-btn{
            width:100% !important;
            min-height:50px !important;
            height:50px !important;
            margin:0 !important;
            box-sizing:border-box !important;
        }

        .uuid-reset-btn{
            background:#ffffff !important;
            color:#ef1f2b !important;
            border:1px solid #ef1f2b !important;
            box-shadow:none !important;
        }

        .uuid-reset-btn:hover{
            background:#fff5f5 !important;
        }

        @media (max-width:600px){
            .uuid-action-row{
                grid-template-columns:1fr;
            }
        }
    </style>
</head>

<body>

<%- include("partials/tool-header") %>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    UUID
                </div>

                <h1>UUID Generator</h1>

                <p>
                    Generate unique UUIDs instantly for apps, databases, APIs, and development projects.
                </p>

            </div>


            <div
                style="
                    text-align:left;
                    margin-bottom:20px;
                "
            >

                <label
                    for="quantity"
                    style="
                        display:block;
                        margin-bottom:8px;
                        font-weight:700;
                        color:#111827;
                    "
                >
                    Number of UUIDs
                </label>


                <input
                    type="number"
                    id="quantity"
                    value="1"
                    min="1"
                    max="100"
                    style="
                        width:100%;
                        padding:13px 15px;
                        border:1px solid #cbd5e1;
                        border-radius:10px;
                        font-size:15px;
                        box-sizing:border-box;
                        outline:none;
                    "
                >

            </div>


            <div class="uuid-action-row">

                <button
                    type="button"
                    class="convert-btn"
                    id="generateBtn"
                >
                    Generate UUID
                </button>

                <button
                    type="button"
                    class="convert-btn uuid-reset-btn"
                    id="resetBtn"
                >
                    Reset
                </button>

            </div>


            <div
                class="result"
                id="result"
                style="display:none;"
            >

                <h2>
                    UUIDs Generated
                </h2>

                <p id="resultInfo"></p>


                <textarea
                    id="outputText"
                    readonly
                    style="
                        width:100%;
                        min-height:180px;
                        margin-top:18px;
                        padding:16px;
                        border:1px solid #d1d5db;
                        border-radius:10px;
                        resize:vertical;
                        font-size:15px;
                        line-height:1.8;
                        font-family:monospace;
                        box-sizing:border-box;
                        background:#ffffff;
                    "
                ></textarea>


                <button
                    type="button"
                    class="download-btn"
                    id="copyBtn"
                >
                    Copy UUIDs
                </button>

            </div>

        </div>

    </div>

</main>


<script>

const quantityInput =
    document.getElementById("quantity");

const generateBtn =
    document.getElementById("generateBtn");

const resetBtn =
    document.getElementById("resetBtn");

const result =
    document.getElementById("result");

const resultInfo =
    document.getElementById("resultInfo");

const outputText =
    document.getElementById("outputText");

const copyBtn =
    document.getElementById("copyBtn");


/* =========================
   GENERATE UUID
========================= */

function generateUUID() {

    if (
        crypto.randomUUID
    ) {

        return crypto.randomUUID();
    }


    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
        .replace(
            /[xy]/g,
            function (c) {

                const r =
                    Math.random() *
                    16 |
                    0;


                const v =
                    c === "x"
                        ? r
                        : (
                            r &
                            0x3 |
                            0x8
                        );


                return v.toString(
                    16
                );
            }
        );
}


/* =========================
   GENERATE BUTTON
========================= */

generateBtn.addEventListener(
    "click",
    function () {

        let quantity =
            parseInt(
                quantityInput.value,
                10
            );


        if (
            isNaN(quantity) ||
            quantity < 1
        ) {

            alert(
                "Please enter a valid quantity."
            );

            return;
        }


        if (
            quantity > 100
        ) {

            quantity =
                100;


            quantityInput.value =
                100;
        }


        const uuids =
            [];


        for (
            let i = 0;
            i < quantity;
            i++
        ) {

            uuids.push(
                generateUUID()
            );
        }


        outputText.value =
            uuids.join(
                "\n"
            );


        resultInfo.textContent =
            `${quantity} UUID${quantity === 1 ? "" : "s"} generated successfully.`;


        result.style.display =
            "block";


        result.scrollIntoView({
            behavior:"smooth",
            block:"nearest"
        });

    }
);


/* =========================
   COPY UUID
========================= */

copyBtn.addEventListener(
    "click",
    async function () {

        if (
            !outputText.value
        ) {
            return;
        }


        try {

            await navigator.clipboard.writeText(
                outputText.value
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy UUIDs";

                },
                1500
            );


        } catch (error) {

            outputText.select();


            document.execCommand(
                "copy"
            );


            copyBtn.textContent =
                "Copied!";


            setTimeout(
                function () {

                    copyBtn.textContent =
                        "Copy UUIDs";

                },
                1500
            );
        }

    }
);


/* =========================
   RESET
========================= */

resetBtn.addEventListener(
    "click",
    function () {

        quantityInput.value =
            "1";


        outputText.value =
            "";


        resultInfo.textContent =
            "";


        result.style.display =
            "none";


        copyBtn.textContent =
            "Copy UUIDs";


        quantityInput.focus();

    }
);

</script>


<footer class="site-footer">

  <div class="container footer-grid">

    <div class="footer-brand">

        <a class="brand" href="/">
            <span class="brand-mark">F</span>
            <span class="brand-name">File<span>Vora</span></span>
        </a>

        <p>
            Fast, simple online tools for everyday file tasks.
        </p>

    </div>

    <div>
        <h3>Company</h3>
        <a href="/about">About Us</a>
        <a href="/contact">Contact Us</a>
        <a href="/security">Security</a>
    </div>

    <div>
        <h3>Resources</h3>
        <a href="/blog">Blog</a>
        <a href="/#tools">Tools</a>
        <a href="/faq">FAQ</a>
    </div>

    <div>
        <h3>Legal</h3>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/disclaimer">Disclaimer</a>
    </div>

    <div>
        <h3>Contact</h3>
        <a href="/contact">Email</a>
        <a href="/contact">Facebook</a>
        <a href="/contact">Instagram</a>
    </div>

  </div>


  <div class="container footer-bottom">

    <span>
        © <span data-current-year></span> FileVora. All rights reserved.
    </span>

    <span>
        All in One Tool.
    </span>

  </div>

</footer>


<script>
document
    .querySelectorAll(
        "[data-current-year]"
    )
    .forEach(
        function (element) {

            element.textContent =
                new Date().getFullYear();
        }
    );
</script>


<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>