```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Time Zone Converter - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">
                    ⏰
                </div>

                <h1>Time Zone Converter</h1>

                <p>
                    Convert date and time between different time zones instantly.
                </p>

            </div>


            <div style="text-align:left;">

                <label
                    for="dateTime"
                    style="display:block; margin-bottom:8px; font-weight:700; color:#111827;"
                >
                    Date & Time
                </label>

                <input
                    type="datetime-local"
                    id="dateTime"
                    style="
                        width:100%;
                        padding:14px;
                        border:1px solid #cbd5e1;
                        border-radius:10px;
                        font-size:16px;
