                                padding:14px;
                                border:1px solid #cbd5e1;
                                border-radius:10px;
                                font-size:16px;
                                background:#fff;
                                box-sizing:border-box;
                            "
                        >
                            <option value="Asia/Colombo">Sri Lanka - Colombo</option>
