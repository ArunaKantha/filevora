<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Color Palette Generator - FileVora</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">🎨</div>

                <h1>Color Palette Generator</h1>

                <p>
                    Generate beautiful random color palettes with HEX codes.
                </p>

            </div>


            <!-- Palette -->

            <div
                id="palette"
                style="
                    display:grid;
                    grid-template-columns:repeat(5, 1fr);
                    gap:10px;
                    margin-bottom:24px;
                "
            >

                <div class="color-box"></div>
                <div class="color-box"></div>
                <div class="color-box"></div>
                <div class="color-box"></div>
                <div class="color-box"></div>

            </div>


            <!-- Generate -->

            <button
                type="button"
                id="generateBtn"
                class="convert-btn"
            >
                Generate New Palette
            </button>


            <!-- Result -->

            <div
                id="result"
                class="result"
                style="display:block;"
            >

                <h2>Color Palette</h2>

                <p id="colorCodes"></p>

                <button
                    type="button"
                    id="copyBtn"
                    class="download-btn"
                >
                    Copy All Colors
                </button>

            </div>

        </div>

    </div>

</main>


<script>

const palette =
    document.getElementById("palette");

const generateBtn =
    document.getElementById("generateBtn");

const colorCodes =
    document.getElementById("colorCodes");

const copyBtn =
    document.getElementById("copyBtn");


let currentColors = [];


/* --------------------------------
   RANDOM COLOR
-------------------------------- */

function randomColor() {

    const characters =
        "0123456789ABCDEF";

    let color = "#";

    for (let i = 0; i < 6; i++) {

        color +=
            characters[
                Math.floor(
                    Math.random() *
                    characters.length
                )
            ];

    }

    return color;

}


/* --------------------------------
   GENERATE PALETTE
-------------------------------- */

function generatePalette() {

    currentColors = [];

    palette.innerHTML = "";

    for (let i = 0; i < 5; i++) {

        const color =
            randomColor();

        currentColors.push(color);


        const box =
            document.createElement("div");

        box.style.backgroundColor =
            color;

        box.style.height =
            "150px";

        box.style.borderRadius =
            "12px";

        box.style.display =
            "flex";

        box.style.alignItems =
            "flex-end";

        box.style.justifyContent =
            "center";

        box.style.padding =
            "10px";

        box.style.boxSizing =
            "border-box";

        box.style.cursor =
            "pointer";

        box.style.transition =
            "transform 0.2s ease";


        box.addEventListener(
            "mouseenter",
            function() {

                box.style.transform =
                    "translateY(-3px)";

            }
        );


        box.addEventListener(
            "mouseleave",
            function() {

                box.style.transform =
                    "translateY(0)";

            }
        );


        /* HEX label */

        const label =
            document.createElement("span");

        label.textContent =
            color;

        label.style.background =
            "rgba(0,0,0,0.55)";

        label.style.color =
            "#ffffff";

        label.style.padding =
            "6px 9px";

        label.style.borderRadius =
            "6px";

        label.style.fontSize =
            "13px";

        label.style.fontWeight =
            "700";

        label.style.fontFamily =
            "monospace";


        box.appendChild(label);

        palette.appendChild(box);

    }


    colorCodes.innerHTML =
        currentColors
            .map(
                color =>
                    `<span style="
                        display:inline-block;
                        margin:4px;
                        padding:8px 10px;
                        background:#f1f5f9;
                        border-radius:7px;
                        font-family:monospace;
                        font-weight:600;
                    ">${color}</span>`
            )
            .join("");


    copyBtn.textContent =
        "Copy All Colors";

}


/* --------------------------------
   COPY
-------------------------------- */

copyBtn.addEventListener(
    "click",
    async function() {

        if (currentColors.length === 0) {
            return;
        }

        try {

            await navigator.clipboard.writeText(
                currentColors.join("\n")
            );

            copyBtn.textContent =
                "Copied!";

        }

        catch (error) {

            copyBtn.textContent =
                "Copy failed";

        }


        setTimeout(
            function() {

                copyBtn.textContent =
                    "Copy All Colors";

            },
            1500
        );

    }
);


/* --------------------------------
   GENERATE BUTTON
-------------------------------- */

generateBtn.addEventListener(
    "click",
    generatePalette
);


/* --------------------------------
   INITIAL PALETTE
-------------------------------- */

generatePalette();

</script>

</body>
</html>