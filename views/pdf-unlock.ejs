<script>

const pdfInput =
    document.getElementById("pdfInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const unlockControls =
    document.getElementById("unlockControls");

const passwordInput =
    document.getElementById("passwordInput");

const unlockBtn =
    document.getElementById("unlockBtn");

const resetBtn =
    document.getElementById("resetBtn");

const result =
    document.getElementById("result");

const downloadBtn =
    document.getElementById("downloadBtn");


let selectedFile = null;
let downloadUrl = null;


function formatFileSize(bytes) {

    if (bytes < 1024) {
        return bytes + " B";
    }

    if (bytes < 1024 * 1024) {
        return (
            bytes / 1024
        ).toFixed(2) + " KB";
    }

    return (
        bytes /
        (1024 * 1024)
    ).toFixed(2) + " MB";
}


pdfInput.addEventListener(
    "change",
    function () {

        selectedFile =
            pdfInput.files[0];


        result.style.display =
            "none";


        if (!selectedFile) {

            fileInfo.style.display =
                "none";

            unlockControls.style.display =
                "none";

            return;
        }


        if (
            selectedFile.type !== "application/pdf" &&
            !selectedFile.name
                .toLowerCase()
                .endsWith(".pdf")
        ) {

            alert(
                "Please choose a PDF file."
            );


            pdfInput.value =
                "";


            selectedFile =
                null;


            fileInfo.style.display =
                "none";


            unlockControls.style.display =
                "none";


            return;
        }


        fileName.textContent =
            selectedFile.name;


        fileSize.textContent =
            formatFileSize(
                selectedFile.size
            );


        fileInfo.style.display =
            "block";


        passwordInput.value =
            "";


        unlockControls.style.display =
            "block";
    }
);


unlockBtn.addEventListener(
    "click",
    async function () {

        if (!selectedFile) {
            return;
        }


        const password =
            passwordInput.value;


        if (!password) {

            alert(
                "Please enter the PDF password."
            );

            passwordInput.focus();

            return;
        }


        unlockBtn.disabled =
            true;


        unlockBtn.textContent =
            "Unlocking PDF...";


        result.style.display =
            "none";


        try {

            if (
                typeof PDFDecrypt ===
                "undefined"
            ) {

                throw new Error(
                    "PDF decryption library failed to load."
                );
            }


            const arrayBuffer =
                await selectedFile.arrayBuffer();


            const encryptedBytes =
                new Uint8Array(
                    arrayBuffer
                );


            const decryptedBytes =
                await PDFDecrypt.decryptPDF(
                    encryptedBytes,
                    password
                );


            const blob =
                new Blob(
                    [decryptedBytes],
                    {
                        type:
                            "application/pdf"
                    }
                );


            if (downloadUrl) {

                URL.revokeObjectURL(
                    downloadUrl
                );
            }


            downloadUrl =
                URL.createObjectURL(
                    blob
                );


            downloadBtn.href =
                downloadUrl;


            downloadBtn.download =
                selectedFile.name.replace(
                    /\.pdf$/i,
                    ""
                ) +
                "-unlocked.pdf";


            result.style.display =
                "block";


        } catch (error) {

            console.error(
                "PDF UNLOCK ERROR:",
                error
            );


            let message =
                error.message ||
                "PDF unlocking failed.";


            if (
                message
                    .toLowerCase()
                    .includes(
                        "incorrect password"
                    )
            ) {

                message =
                    "Incorrect PDF password.";
            }


            if (
                message
                    .toLowerCase()
                    .includes(
                        "not encrypted"
                    )
            ) {

                message =
                    "This PDF is not password protected.";
            }


            alert(
                "PDF unlocking could not be completed.\n\n" +
                message
            );

        } finally {

            unlockBtn.disabled =
                false;


            unlockBtn.textContent =
                "Unlock PDF";
        }
    }
);


resetBtn.addEventListener(
    "click",
    function () {

        pdfInput.value =
            "";


        selectedFile =
            null;


        fileName.textContent =
            "";


        fileSize.textContent =
            "";


        passwordInput.value =
            "";


        fileInfo.style.display =
            "none";


        unlockControls.style.display =
            "none";


        result.style.display =
            "none";


        unlockBtn.disabled =
            false;


        unlockBtn.textContent =
            "Unlock PDF";


        downloadBtn.href =
            "#";


        if (downloadUrl) {

            URL.revokeObjectURL(
                downloadUrl
            );


            downloadUrl =
                null;
        }
    }
);

</script>


<script src="/js/filevora-tools.js"></script>
<script src="/js/filevora-header-tools.js"></script>

</body>
</html>