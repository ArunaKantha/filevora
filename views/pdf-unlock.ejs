<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="Unlock PDF files online with FileVora. Remove PDF password protection when you have the password.">

    <title>Unlock PDF — FileVora</title>

    <link rel="stylesheet" href="/css/style.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
</head>

<body>

<header class="site-header">
    <div class="container nav">

        <a class="brand" href="/">
            <span class="brand-mark">F</span>
            <span>File<span>Vora</span></span>
        </a>

        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/#tools">Tools</a>
            <a href="/#categories">Categories</a>
        </nav>

    </div>
</header>


<main class="converter-page">

    <div class="container">

        <div class="converter-card">

            <div class="converter-header">

                <div class="tool-icon">PDF</div>

                <h1>Unlock PDF</h1>

                <p>
                    Remove password protection from a PDF when you know the password.
                </p>

            </div>


            <label class="upload-area" for="pdfInput">

                <div class="upload-icon">🔓</div>

                <strong>Choose a PDF file</strong>

                <span>PDF files only</span>

            </label>


            <input
                id="pdfInput"
                type="file"
                accept="application/pdf,.pdf"
            >


            <div class="file-info" id="fileInfo">

                <strong id="fileName"></strong>

                <span id="fileSize"></span>

            </div>


            <div
                id="passwordBox"
                style="display:none; margin-top:20px; text-align:left;"
            >

                <label
                    for="passwordInput"
                    style="display:block; margin-bottom:8px; font-weight:700; color:#111827;"
                >
                    PDF Password
                </label>

                <input
                    id="passwordInput"
                    type="password"
                    placeholder="Enter the current PDF password"
                    autocomplete="off"
                    style="width:100%; box-sizing:border-box; padding:13px 14px; border:1px solid #cbd5e1; border-radius:10px; font-size:15px;"
                >

            </div>


            <button
                class="convert-btn"
                id="unlockBtn"
                disabled
            >
                Unlock PDF
            </button>


            <div class="result" id="result">

                <h2>PDF Ready</h2>

                <p>
                    Your unlocked PDF is ready to download.
                </p>

                <a
                    id="downloadBtn"
                    class="download-btn"
                    download="filevora-unlocked.pdf"
                >
                    ↓ Download Unlocked PDF
                </a>

            </div>

        </div>

    </div>

</main>


<footer>

    <div class="container footer-inner">

        <a class="brand" href="/">
            <span class="brand-mark">F</span>
            <span>File<span>Vora</span></span>
        </a>

        <p>
            © <span id="year"></span> FILEVORA. All rights reserved.
        </p>

    </div>

</footer>


<script>

const pdfInput =
    document.getElementById("pdfInput");

const fileInfo =
    document.getElementById("fileInfo");

const fileName =
    document.getElementById("fileName");

const fileSize =
    document.getElementById("fileSize");

const passwordBox =
    document.getElementById("passwordBox");

const passwordInput =
    document.getElementById("passwordInput");

const unlockBtn =
    document.getElementById("unlockBtn");

const result =
    document.getElementById("result");

const downloadBtn =
    document.getElementById("downloadBtn");


pdfInput.addEventListener("change", () => {

    const file =
        pdfInput.files[0];


    if (!file) {

        unlockBtn.disabled = true;

        fileInfo.style.display = "none";

        passwordBox.style.display = "none";

        result.style.display = "none";

        return;
    }


    if (file.type !== "application/pdf") {

        alert("Please choose a PDF file.");

        pdfInput.value = "";

        return;
    }


    fileName.textContent =
        file.name;


    const sizeMB =
        file.size / (1024 * 1024);


    fileSize.textContent =
        sizeMB >= 1
            ? sizeMB.toFixed(2) + " MB"
            : (file.size / 1024).toFixed(2) + " KB";


    fileInfo.style.display =
        "block";


    passwordBox.style.display =
        "block";


    unlockBtn.disabled =
        false;


    result.style.display =
        "none";

});


unlockBtn.addEventListener("click", async () => {

    const file =
        pdfInput.files[0];


    if (!file) return;


    const password =
        passwordInput.value;


    if (!password) {

        alert(
            "Please enter the PDF password."
        );

        passwordInput.focus();

        return;
    }


    unlockBtn.disabled =
        true;


    unlockBtn.textContent =
        "Unlocking PDF...";


    try {

        if (
            typeof PDFLib === "undefined"
        ) {

            throw new Error(
                "PDF library failed to load."
            );

        }


        /*
         * pdf-lib cannot open encrypted/password
         * protected PDF files directly.
         *
         * Proper PDF decryption will be added
         * with a server-side PDF engine later.
         */

        throw new Error(
            "Password-protected PDF unlocking requires a server-side PDF engine."
        );


    } catch (error) {

        console.error(
            "PDF UNLOCK ERROR:",
            error
        );


        alert(
            "PDF unlocking could not be completed.\n\n" +
            error.message
        );


        unlockBtn.disabled =
            false;


        unlockBtn.textContent =
            "Unlock PDF";

    }

});


document.getElementById(
    "year"
).textContent =
    new Date().getFullYear();

</script>

</body>
</html>