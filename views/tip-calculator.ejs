<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tip Calculator - FileVora</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .tip-calculator {
            max-width: 760px;
        }

        .tip-form {
            display: grid;
            gap: 18px;
        }

        .field-group {
            text-align: left;
        }

        .field-group label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-size: 14px;
            font-weight: 700;
        }

        .input-wrapper {
            position: relative;
        }

        .currency-symbol {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 16px;
            font-weight: 700;
        }

        .tip-input {
            width: 100%;
            padding: 14px 16px 14px 38px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #f8fafc;
            color: #111827;
            font-size: 16px;
            outline: none;
            box-sizing: border-box;
        }

        .tip-input:focus {
            border-color: #2563eb;
            background: #ffffff;
        }

        .tip-percent {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #f8fafc;
            color: #111827;
            font-size: 16px;
            outline: none;
            box-sizing: border-box;
        }

        .tip-percent:focus {
            border-color: #2563eb;
            background: #ffffff;
        }

        .tip-buttons {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-top: 10px;
        }

        .percent-btn {
            padding: 10px 6px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #ffffff;
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        .percent-btn:hover {
            background: #eff6ff;
            border-color: #93c5fd;
            color: #2563eb;
        }

        .people-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .people-btn {
            width: 44px;
            height: 44px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            background: #f8fafc;
            color: #2563eb;
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
        }

        .people-btn:hover {
            background: #eff6ff;
        }

        .people-input {
            flex: 1;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            background: #f8fafc;
            color: #111827;
            font-size: 16px;
            text-align: center;
            outline: none;
        }

        .calculate-btn {
            width: 100%;
            margin-top: 4px;
            padding: 14px 22px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .calculate-btn:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .tip-result {
            display: none;
            margin-top: 28px;
            padding: 24px;
            border-radius: 14px;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .tip-result h2 {
            margin: 0 0 18px;
            color: #166534;
            font-size: 20px;
        }

        .result-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .result-item {
            padding: 16px;
            background: #ffffff;
            border: 1px solid #dcfce7;
            border-radius: 10px;
            text-align: left;
        }

        .result-item span {
            display: block;
            margin-bottom: 5px;
            color: #64748b;
            font-size: 13px;
        }

        .result-item strong {
            display: block;
            color: #166534;
            font-size: 20px;
        }

        .total-result {
            grid-column: 1 / -1;
        }

        .total-result strong {
            font-size: 25px;
        }

        .error-message {
            display: none;
            margin-top: 18px;
            padding: 13px;
            border-radius: 10px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 14px;
            text-align: left;
        }

        @media (max-width: 600px) {
            .tip-buttons {
                grid-template-columns: repeat(3, 1fr);
            }

            .result-grid {
                grid-template-columns: 1fr;
            }

            .total-result {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>

<div class="converter-page">

    <div class="container">

        <div class="converter-card tip-calculator">

            <div class="converter-header">

                <div class="tool-icon">%</div>

                <h1>Tip Calculator</h1>

                <p>
                    Calculate tip, total bill and amount per person quickly.
                </p>

            </div>


            <div class="tip-form">

                <div class="field-group">

                    <label for="billAmount">
                        Bill Amount
                    </label>

                    <div class="input-wrapper">

                        <span class="currency-symbol">$</span>

                        <input
                            type="number"
                            id="billAmount"
                            class="tip-input"
                            placeholder="100"
                            min="0"
                            step="0.01"
                        >

                    </div>

                </div>


                <div class="field-group">

                    <label for="tipPercent">
                        Tip Percentage
                    </label>

                    <input
                        type="number"
                        id="tipPercent"
                        class="tip-percent"
                        value="15"
                        min="0"
                        step="0.1"
                    >

                    <div class="tip-buttons">

                        <button
                            class="percent-btn"
                            onclick="setTip(5)">
                            5%
                        </button>

                        <button
                            class="percent-btn"
                            onclick="setTip(10)">
                            10%
                        </button>

                        <button
                            class="percent-btn"
                            onclick="setTip(15)">
                            15%
                        </button>

                        <button
                            class="percent-btn"
                            onclick="setTip(20)">
                            20%
                        </button>

                        <button
                            class="percent-btn"
                            onclick="setTip(25)">
                            25%
                        </button>

                    </div>

                </div>


                <div class="field-group">

                    <label>
                        Number of People
                    </label>

                    <div class="people-control">

                        <button
                            class="people-btn"
                            onclick="changePeople(-1)">
                            −
                        </button>

                        <input
                            type="number"
                            id="people"
                            class="people-input"
                            value="1"
                            min="1"
                            step="1"
                        >

                        <button
                            class="people-btn"
                            onclick="changePeople(1)">
                            +
                        </button>

                    </div>

                </div>


                <button
                    class="calculate-btn"
                    onclick="calculateTip()">

                    Calculate Tip

                </button>

            </div>


            <div
                id="errorMessage"
                class="error-message">
            </div>


            <div
                id="tipResult"
                class="tip-result">

                <h2>Bill Summary</h2>

                <div class="result-grid">

                    <div class="result-item">
                        <span>Bill Amount</span>
                        <strong id="billResult">$0.00</strong>
                    </div>

                    <div class="result-item">
                        <span>Tip Amount</span>
                        <strong id="tipResultValue">$0.00</strong>
                    </div>

                    <div class="result-item">
                        <span>Total Bill</span>
                        <strong id="totalResult">$0.00</strong>
                    </div>

                    <div class="result-item">
                        <span>Tip Per Person</span>
                        <strong id="tipPerPerson">$0.00</strong>
                    </div>

                    <div class="result-item total-result">
                        <span>Total Per Person</span>
                        <strong id="totalPerPerson">$0.00</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    function setTip(percent) {

        document.getElementById(
            "tipPercent"
        ).value = percent;

    }


    function changePeople(amount) {

        const input =
            document.getElementById(
                "people"
            );

        let value =
            parseInt(input.value) || 1;

        value += amount;

        if (value < 1) {
            value = 1;
        }

        input.value = value;
    }


    function formatMoney(value) {

        return "$" +
            Number(value).toFixed(2);
    }
function calculateTip() {

    const billInput =
        document.getElementById("billAmount").value.trim();

    const tipInput =
        document.getElementById("tipPercent").value.trim();

    const peopleInput =
        document.getElementById("people").value.trim();

    const bill = Number(billInput);
    const tipPercent = Number(tipInput);
    const people = Number(peopleInput);

    const resultBox =
        document.getElementById("tipResult");

    const errorBox =
        document.getElementById("errorMessage");


    resultBox.style.display = "none";
    errorBox.style.display = "none";


    if (
        billInput === "" ||
        !Number.isFinite(bill) ||
        bill < 0
    ) {
        showError("Please enter a valid bill amount.");
        return;
    }


    if (
        tipInput === "" ||
        !Number.isFinite(tipPercent) ||
        tipPercent < 0
    ) {
        showError("Please enter a valid tip percentage.");
        return;
    }


    if (
        peopleInput === "" ||
        !Number.isFinite(people) ||
        !Number.isInteger(people) ||
        people < 1
    ) {
        showError("Number of people must be at least 1.");
        return;
    }


    // Calculate tip
    const tipAmount =
        bill * tipPercent / 100;


    // Calculate total
    const totalBill =
        bill + tipAmount;


    // IMPORTANT: divide by number of people
    const tipPerPerson =
        tipAmount / people;


    const totalPerPerson =
        totalBill / people;


    document.getElementById(
        "billResult"
    ).textContent =
        formatMoney(bill);


    document.getElementById(
        "tipResultValue"
    ).textContent =
        formatMoney(tipAmount);


    document.getElementById(
        "totalResult"
    ).textContent =
        formatMoney(totalBill);


    document.getElementById(
        "tipPerPerson"
    ).textContent =
        formatMoney(tipPerPerson);


    document.getElementById(
        "totalPerPerson"
    ).textContent =
        formatMoney(totalPerPerson);


    resultBox.style.display = "block";
}
    document.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Enter") {

                calculateTip();

            }

        }
    );

</script>

</body>
</html>